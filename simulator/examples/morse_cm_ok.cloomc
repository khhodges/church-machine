BRANCHNE k_dah2_i
ISUB DR3, DR3, #1
BRANCHNE k_dah2_m
ISUB DR4, DR4, #1
BRANCHNE k_dah2_o
ISUB DR5, DR5, #1
BRANCHNE k_dah2_s
DWRITE DR0, CR3, 0            ; LED0 = 0 (element gap — 1 dit done)
IADD DR5, DR0, #1
k_dah2g_s:
IADD DR4, DR0, #2
k_dah2g_o:
IADD DR3, DR0, #2
k_dah2g_m:
IADD DR2, DR0, #2
k_dah2g_i:
ISUB DR2, DR2, #1
BRANCHNE k_dah2g_i
ISUB DR3, DR3, #1
BRANCHNE k_dah2g_m
ISUB DR4, DR4, #1
BRANCHNE k_dah2g_o
ISUB DR5, DR5, #1
BRANCHNE k_dah2g_s
; K → C word gap: 6 extra dits silence (1 dit element gap already done → total 7)
k_wg:
IADD DR5, DR0, #6
k_wg_s:
IADD DR4, DR0, #2
k_wg_o:
IADD DR3, DR0, #2
k_wg_m:
IADD DR2, DR0, #2
k_wg_i:
ISUB DR2, DR2, #1
BRANCHNE k_wg_i
ISUB DR3, DR3, #1
BRANCHNE k_wg_m
ISUB DR4, DR4, #1
BRANCHNE k_wg_o
ISUB DR5, DR5, #1
BRANCHNE k_wg_s

BRANCH morse              ; loop forever
