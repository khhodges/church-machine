ISUB DR3, DR3, #1
BRANCHNE m_dah1g_m
ISUB DR4, DR4, #1
BRANCHNE m_dah1g_o
ISUB DR5, DR5, #1
BRANCHNE m_dah1g_s

m_dah2:
DWRITE DR1, CR3, 0            ; LED0 = 1
IADD DR5, DR0, #3             ; dah
m_dah2_s:
IADD DR4, DR0, #2
m_dah2_o:
IADD DR3, DR0, #2
m_dah2_m:
IADD DR2, DR0, #2
m_dah2_i:
ISUB DR2, DR2, #1
BRANCHNE m_dah2_i
ISUB DR3, DR3, #1
BRANCHNE m_dah2_m
ISUB DR4, DR4, #1
BRANCHNE m_dah2_o
ISUB DR5, DR5, #1
BRANCHNE m_dah2_s
DWRITE DR0, CR3, 0            ; LED0 = 0 (element gap — 1 dit done)
IADD DR5, DR0, #1
m_dah2g_s:
IADD DR4, DR0, #2
m_dah2g_o:
IADD DR3, DR0, #2
m_dah2g_m:
IADD DR2, DR0, #2
m_dah2g_i:
ISUB DR2, DR2, #1
BRANCHNE m_dah2g_i
ISUB DR3, DR3, #1
BRANCHNE m_dah2g_m
ISUB DR4, DR4, #1
BRANCHNE m_dah2g_o
ISUB DR5, DR5, #1
BRANCHNE m_dah2g_s
; M → O word gap: 6 extra dits silence (1 dit element gap already done → total 7)
m_wg:
IADD DR5, DR0, #6
m_wg_s:
IADD DR4, DR0, #2
m_wg_o:
IADD DR3, DR0, #2
m_wg_m:
IADD DR2, DR0, #2
m_wg_i:
ISUB DR2, DR2, #1
BRANCHNE m_wg_i
ISUB DR3, DR3, #1
BRANCHNE m_wg_m
ISUB DR4, DR4, #1
BRANCHNE m_wg_o
ISUB DR5, DR5, #1
BRANCHNE m_wg_s

; ────────────────────────────────────────────────────────────
; Letter O  =  --- (dah dah dah)
; ────────────────────────────────────────────────────────────

o_dah1:
DWRITE DR1, CR3, 0            ; LED0 = 1
IADD DR5, DR0, #3             ; dah
o_dah1_s:
IADD DR4, DR0, #2
o_dah1_o:
IADD DR3, DR0, #2
o_dah1_m:
IADD DR2, DR0, #2
o_dah1_i:
ISUB DR2, DR2, #1
BRANCHNE o_dah1_i
ISUB DR3, DR3, #1
BRANCHNE o_dah1_m
ISUB DR4, DR4, #1
BRANCHNE o_dah1_o
ISUB DR5, DR5, #1
BRANCHNE o_dah1_s
DWRITE DR0, CR3, 0            ; LED0 = 0 (element gap)
IADD DR5, DR0, #1
o_dah1g_s:
IADD DR4, DR0, #2
o_dah1g_o:
IADD DR3, DR0, #2
o_dah1g_m:
IADD DR2, DR0, #2
o_dah1g_i:
ISUB DR2, DR2, #1
BRANCHNE o_dah1g_i
ISUB DR3, DR3, #1
BRANCHNE o_dah1g_m
ISUB DR4, DR4, #1
BRANCHNE o_dah1g_o
ISUB DR5, DR5, #1
BRANCHNE o_dah1g_s

o_dah2:
DWRITE DR1, CR3, 0            ; LED0 = 1
IADD DR5, DR0, #3             ; dah
o_dah2_s:
IADD DR4, DR0, #2
o_dah2_o:
IADD DR3, DR0, #2
o_dah2_m:
IADD DR2, DR0, #2
o_dah2_i:
ISUB DR2, DR2, #1
BRANCHNE o_dah2_i
ISUB DR3, DR3, #1
BRANCHNE o_dah2_m
ISUB DR4, DR4, #1
BRANCHNE o_dah2_o
ISUB DR5, DR5, #1
BRANCHNE o_dah2_s
DWRITE DR0, CR3, 0            ; LED0 = 0 (element gap)
IADD DR5, DR0, #1
o_dah2g_s:
IADD DR4, DR0, #2
o_dah2g_o:
IADD DR3, DR0, #2
o_dah2g_m:
IADD DR2, DR0, #2
o_dah2g_i:
ISUB DR2, DR2, #1
BRANCHNE o_dah2g_i
ISUB DR3, DR3, #1
BRANCHNE o_dah2g_m
ISUB DR4, DR4, #1
BRANCHNE o_dah2g_o
ISUB DR5, DR5, #1
BRANCHNE o_dah2g_s

o_dah3:
DWRITE DR1, CR3, 0            ; LED0 = 1
IADD DR5, DR0, #3             ; dah
o_dah3_s:
IADD DR4, DR0, #2
o_dah3_o:
IADD DR3, DR0, #2
o_dah3_m:
IADD DR2, DR0, #2
o_dah3_i:
ISUB DR2, DR2, #1
BRANCHNE o_dah3_i
ISUB DR3, DR3, #1
BRANCHNE o_dah3_m
ISUB DR4, DR4, #1
BRANCHNE o_dah3_o
ISUB DR5, DR5, #1
BRANCHNE o_dah3_s
DWRITE DR0, CR3, 0            ; LED0 = 0 (element gap — 1 dit done)
IADD DR5, DR0, #1
o_dah3g_s:
IADD DR4, DR0, #2
o_dah3g_o:
IADD DR3, DR0, #2
o_dah3g_m:
IADD DR2, DR0, #2
o_dah3g_i:
ISUB DR2, DR2, #1
BRANCHNE o_dah3g_i
ISUB DR3, DR3, #1
BRANCHNE o_dah3g_m
ISUB DR4, DR4, #1
BRANCHNE o_dah3g_o
ISUB DR5, DR5, #1
BRANCHNE o_dah3g_s
; O → K letter gap: 2 extra dits silence
o_lg:
IADD DR5, DR0, #2
o_lg_s:
IADD DR4, DR0, #2
o_lg_o:
IADD DR3, DR0, #2
o_lg_m:
IADD DR2, DR0, #2
o_lg_i:
