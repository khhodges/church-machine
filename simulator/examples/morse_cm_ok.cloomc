BRANCHNE k_dit1_i
ISUB DR3, DR3, #1
BRANCHNE k_dit1_m
ISUB DR4, DR4, #1
BRANCHNE k_dit1_o
ISUB DR5, DR5, #1
BRANCHNE k_dit1_s
DWRITE DR0, CR3, 0            ; LED0 = 0 (element gap)
IADD DR5, DR0, #1
k_dit1g_s:
IADD DR4, DR0, #2
k_dit1g_o:
IADD DR3, DR0, #2
k_dit1g_m:
