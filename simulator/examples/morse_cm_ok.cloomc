BRANCHNE o_lg_i
ISUB DR3, DR3, #1
BRANCHNE o_lg_m
ISUB DR4, DR4, #1
BRANCHNE o_lg_o
ISUB DR5, DR5, #1
BRANCHNE o_lg_s

; ────────────────────────────────────────────────────────────
; Letter K  =  -.- (dah dit dah)
; ────────────────────────────────────────────────────────────

k_dah1:
DWRITE DR1, CR3, 0            ; LED0 = 1
IADD DR5, DR0, #3             ; dah
k_dah1_s:
IADD DR4, DR0, #2
k_dah1_o:
IADD DR3, DR0, #2
k_dah1_m:
IADD DR2, DR0, #2
k_dah1_i:
ISUB DR2, DR2, #1
BRANCHNE k_dah1_i
ISUB DR3, DR3, #1
BRANCHNE k_dah1_m
ISUB DR4, DR4, #1
BRANCHNE k_dah1_o
ISUB DR5, DR5, #1
BRANCHNE k_dah1_s
DWRITE DR0, CR3, 0            ; LED0 = 0 (element gap)
IADD DR5, DR0, #1
k_dah1g_s:
IADD DR4, DR0, #2
k_dah1g_o:
IADD DR3, DR0, #2
k_dah1g_m:
IADD DR2, DR0, #2
k_dah1g_i:
