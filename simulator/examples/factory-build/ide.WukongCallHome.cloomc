method Sample() {
; DR1 is the verified unsigned Alice read-back. Store numeric data only.
LOAD CR2, CR6, #1
DWRITE DR1, CR2, #407
IADD DR2, DR0, #1
DWRITE DR2, CR2, #408
RETURN
}
method Fault() {
; Known event, unavailable event date/time. Retain until fresh image.
LOAD CR2, CR6, #1
IADD DR2, DR0, #1
DWRITE DR2, CR2, #409
RETURN
.word 0
