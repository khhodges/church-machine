; REVIEW DESIGN — intentionally Lazy, absent until delivery is accepted.
; Successful retry sets DR12=13 and returns to USER A.
; This source is not the five-word diagnostic transport payload: the normal
; compiler emits an API/method table and must be reviewed before a new build.
abstraction ide.CooperativePayload {
    capabilities { SELF E }
    method Run() {
        IADD DR12, DR0, #13
        RETURN
    }
}
