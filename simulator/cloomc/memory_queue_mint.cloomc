; Isolated Mint endpoint. Two immutable instances bind different private
; Config capabilities to the same FreeHandler. No Config, Namespace RW,
; FreeHandler E or SecurityMonitor E capability is returned to the caller.
; Namespace mutation occurs only in the same-scope update block below.
; Terminal policy matches the conservative existing Mint: retire at 511,
; never issue a reusable generation 511 and never wrap.
abstraction ide.MemoryQueueMint {
passkey required;
capabilities {
    SELF E, ide.MemoryQueueFreeHandler E, ide.Namespace RW,
    ide.ProducerConfig R, ide.QueueScheduler.Thread,
    ide.SecurityMonitorCreateData E
}
method Create(size: U32) -> Inform[RW] {
    .pet AllocationState CR3
    .pet FreeHandler CR0
    LOAD AllocationState, CR6, #3
    LOAD FreeHandler, CR6, #1
    CALL FreeHandler, #0
    RETURNAL #2
}
method Destroy(block: Inform[RW]) -> Void {
    .pet FreeHandler CR0
    .pet InvocationConfig CR3
    .pet Namespace CR10
    .pet Slot DR2
    .pet OldVersion DR3
    .pet NamespaceOffset DR6
    .pet NewVersion DR7
    .pet LocationWord DR8
    .pet LimitWord DR9
    .pet IntegrityWord DR10
    .pet Status DR1
    LOAD InvocationConfig, CR6, #3
    LOAD FreeHandler, CR6, #1
    CALL FreeHandler, #1
reserve_complete:
    ; Deliberate native scheduling point: the second producer can complete
    ; before the first producer's reserved send. No queue lock is held.
    LOAD InvocationConfig, CR6, #3
    DREAD DR6, InvocationConfig, #1, DR0
    MCMP DR6, #0
    BRANCHEQ begin_invalidate
    LOAD CR2, CR6, #4
    CHANGE CR2
begin_invalidate:
    LOAD InvocationConfig, CR6, #3
    LOAD FreeHandler, CR6, #1
    CALL FreeHandler, #2
irreversible_latched:
    ; Private same-scope single-slot write boundary, under the owned guard.
    LOAD Namespace, CR6, #2
    SHL NamespaceOffset, Slot, #2
    LOAD InvocationConfig, CR6, #3
    DREAD DR11, InvocationConfig, #6, DR0
    ISUB DR11, DR11, #4
    ISUB NamespaceOffset, DR11, NamespaceOffset
    DREAD LocationWord, Namespace, #0, NamespaceOffset
    DREAD LimitWord, Namespace, #1, NamespaceOffset
    BFEXT DR4, LimitWord, #21, #9
    MCMP DR4, OldVersion
    BRANCHNE mutation_bad
    MCMP OldVersion, #510
    BRANCHHS retire_slot
    IADD NewVersion, OldVersion, #1
    BFINS LimitWord, NewVersion, #21, #9
    DWRITE LimitWord, Namespace, #1, NamespaceOffset
version_advanced:
    ; Existing Namespace integrity32, implemented in CLOOMC, not a callback.
    BFEXT DR12, LocationWord, #25, #7
    SHL DR13, LocationWord, #7
    BFINS DR13, DR12, #0, #7
    IADD DR14, LimitWord, #0
    BFINS DR14, DR0, #30, #2
    BFEXT DR12, DR14, #19, #13
    SHL DR14, DR14, #13
    BFINS DR14, DR12, #0, #13
    IADD DR15, DR0, #222
    SHL DR15, DR15, #8
    IADD DR15, DR15, #173
    SHL DR15, DR15, #8
    IADD DR15, DR15, #190
    SHL DR15, DR15, #8
    IADD DR15, DR15, #239
    IADD IntegrityWord, DR0, #0
    IADD DR4, DR0, #32
integrity_bits:
    BFEXT DR1, DR13, #0, #1
    BFEXT DR2, DR14, #0, #1
    BFEXT DR3, DR15, #0, #1
    IADD DR1, DR1, DR2
    IADD DR1, DR1, DR3
    SHR IntegrityWord, IntegrityWord, #1
    BFINS IntegrityWord, DR1, #31, #1
    SHR DR13, DR13, #1
    SHR DR14, DR14, #1
    SHR DR15, DR15, #1
    ISUB DR4, DR4, #1
    MCMP DR4, DR0
    BRANCHNE integrity_bits
    DWRITE IntegrityWord, Namespace, #2, NamespaceOffset
descriptor_complete:
    LOAD InvocationConfig, CR6, #3
    DREAD DR11, InvocationConfig, #6, DR0
    ISUB DR11, DR11, #4
    ISUB Slot, DR11, NamespaceOffset
    SHR Slot, Slot, #2
    IADD DR3, NewVersion, #0
    LOAD CR0, CR6, #5
    CALL CR0, #0
constructed:
    LOAD InvocationConfig, CR6, #3
    LOAD FreeHandler, CR6, #1
    CALL FreeHandler, #3
staged:
    LOAD InvocationConfig, CR6, #3
    LOAD FreeHandler, CR6, #1
    CALL FreeHandler, #4
    RETURNAL #0
retire_slot:
    ; Descriptor invalidation, not recycling or version wrap.
    DWRITE DR0, Namespace, #2, NamespaceOffset
    IADD NewVersion, DR0, #511
    BFINS LimitWord, NewVersion, #21, #9
    DWRITE LimitWord, Namespace, #1, NamespaceOffset
    DWRITE DR0, Namespace, #0, NamespaceOffset
    DWRITE DR0, Namespace, #3, NamespaceOffset
terminal_invalidated:
    LOAD InvocationConfig, CR6, #3
    LOAD FreeHandler, CR6, #1
    CALL FreeHandler, #6
    RETURNAL #0
mutation_bad:
    HARDFAULT "Mint.DESTROY: Namespace generation changed before the owned update"
}
}
