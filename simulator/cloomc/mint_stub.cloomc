// Isolated, uninstalled ABI scaffold. No method implements an operation.
// Every call returns UNSUPPORTED (5), discarding the incoming CR1 PassKey.
// The compiler derives the embedded ABI from these typed declarations.
// Bodies are native instructions; unsupported calls never authorize access.
abstraction ide.Mint {
passkey required;
capabilities { SELF E }
method CREATE(allocation: U32, permissions: U32) -> Inform[RW] {
    LOAD CR1, NULL
    IADD DR1, DR0, #5
    RETURNAL #0
}
method DESTROY(target: Inform[RW]) -> Void {
    LOAD CR1, NULL
    IADD DR1, DR0, #5
    RETURNAL #0
}
method MakeOutform(target: Inform[RW]) -> Outform[RW] {
    LOAD CR1, NULL
    IADD DR1, DR0, #5
    RETURNAL #0
}
method MakeInform(target: Outform[RW]) -> Inform[RW] {
    LOAD CR1, NULL
    IADD DR1, DR0, #5
    RETURNAL #0
}
}
