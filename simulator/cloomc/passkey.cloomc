; Phase 1 Passkey -- Genesis-controlled E capability; no public name grants.
; Language: Assembly
; NewProof(name): CR2=name DATA R (header,length,ASCII words).
; Result CR1=B=0 Abstract proof GT, DR1=1. All offsets are words.
; State: header,count,capacity,cursor,scratch,reserved,33-word name/token records.
; Scratch L views State[4]. Serialize calls and retain state with this exact pool.
; Original 100 random values, preformatted once; never regenerated at startup.
abstraction ide.Passkey {
capabilities { SELF E, ide.PasskeyState RW, ide.PasskeyScratch L }
method NewProof {
    ; Header + one method entry + branch: embedded pool starts at word 3.
    BRANCH proof_entry
proof_pool:
    .word 0x3f6ccfe8
    .word 0x3e4dad67
    .word 0x374ab3cc
    .word 0x3f7e9082
    .word 0x268777fa
    .word 0x37ed7000
    .word 0x261fca62
    .word 0x2e95410c
    .word 0x26f79512
    .word 0x3efeda3f
    .word 0x3fa8ae8c
    .word 0x2fb7d4ce
    .word 0x3606d83a
    .word 0x273f9411
    .word 0x363388f2
    .word 0x362d5b68
    .word 0x2e0b6c83
    .word 0x27531258
    .word 0x260364fe
    .word 0x27680ebf
    .word 0x37ed9464
    .word 0x364c9275
    .word 0x36ce6bb3
    .word 0x3e74eeaf
    .word 0x3ece46d4
    .word 0x2f2f21c1
    .word 0x3f75ca7c
    .word 0x3705873f
    .word 0x2712f7fd
    .word 0x3f08fa90
    .word 0x2e47b4c5
    .word 0x2f4b8b7c
    .word 0x3f8b9a3c
    .word 0x3699d31f
    .word 0x276a05f8
    .word 0x2ff23cc5
    .word 0x36fa6747
    .word 0x378a7ace
    .word 0x26b714a2
    .word 0x369a0341
    .word 0x264c660d
    .word 0x274b1fc4
    .word 0x2651c103
    .word 0x3e34a12b
    .word 0x3ebaf20f
    .word 0x3ffa9f61
    .word 0x3f92e4ba
    .word 0x2e4111fb
    .word 0x3f06e0fd
    .word 0x368079f9
    .word 0x2e16a471
    .word 0x260074fd
    .word 0x26098d51
    .word 0x2e92151b
    .word 0x2fa21db2
    .word 0x27e31c27
    .word 0x3f9f9b92
    .word 0x3f2f8bee
    .word 0x2721e920
    .word 0x3ef8fc58
    .word 0x37315685
    .word 0x3fcbf772
    .word 0x3657b5ca
    .word 0x36af5317
    .word 0x3711c031
    .word 0x3e5fbda5
    .word 0x26819d82
    .word 0x3ec32b51
    .word 0x36d441c5
    .word 0x3fa0477e
    .word 0x3ef8ac39
    .word 0x26436320
    .word 0x36345cd7
    .word 0x3e0e281b
    .word 0x3721e7ac
    .word 0x37c6f710
    .word 0x3e74ea2b
    .word 0x266c9a45
    .word 0x3ee7c6b6
    .word 0x374ac960
    .word 0x2747fadf
    .word 0x3736a0dd
    .word 0x37d3bb89
    .word 0x3e349b6f
    .word 0x3f4cdce3
    .word 0x3fc9fb90
    .word 0x26a897df
    .word 0x2f090fd3
    .word 0x3f330f8d
    .word 0x2f8aed7a
    .word 0x2ee1b955
    .word 0x375dee92
    .word 0x3f216769
    .word 0x368884a8
    .word 0x2f4a3c3a
    .word 0x2e9467b8
    .word 0x2f0cac77
    .word 0x3e4592b2
    .word 0x2eee1009
    .word 0x366dc09e
proof_entry:
    IADD DR1, DR0, #0
    DREAD DR6, CR2, #1, DR0
    MCMP DR6, #1
    BRANCHLO proof_bad_name
    MCMP DR6, #31
    BRANCHHI proof_bad_name
    IADD DR10, DR0, #0
proof_validate_name:
    MCMP DR10, DR6
    BRANCHHS proof_load_state
    DREAD DR11, CR2, #2, DR10
    MCMP DR11, #33
    BRANCHLO proof_bad_name
    MCMP DR11, #126
    BRANCHHI proof_bad_name
    IADD DR10, DR10, #1
    BRANCH proof_validate_name
proof_load_state:
    LOAD CR7, CR6, #1
    LOAD CR9, CR6, #2
    DREAD DR7, CR7, #1, DR0
    DREAD DR14, CR7, #2, DR0
    MCMP DR14, #1024
    BRANCHHI proof_bad_state
    MCMP DR7, DR14
    BRANCHHI proof_bad_state
    IADD DR8, DR0, #6
    IADD DR9, DR0, #0
proof_find:
    MCMP DR9, DR7
    BRANCHHS proof_capacity
    DREAD DR11, CR7, #0, DR8
    MCMP DR11, DR6
    BRANCHNE proof_next
    IADD DR10, DR0, #0
proof_chars:
    MCMP DR10, DR6
    BRANCHHS proof_duplicate
    DREAD DR11, CR2, #2, DR10
    IADD DR12, DR8, DR10
    DREAD DR12, CR7, #2, DR12
    MCMP DR11, DR12
    BRANCHNE proof_next
    IADD DR10, DR10, #1
    BRANCH proof_chars
proof_next:
    IADD DR9, DR9, #1
    IADD DR8, DR8, #33
    BRANCH proof_find
proof_capacity:
    MCMP DR7, DR14
    BRANCHHS proof_full
proof_random:
    DREAD DR14, CR7, #3, DR0
    MCMP DR14, #100
    BRANCHHI proof_bad_state
    BRANCHEQ proof_no_random
    DREAD DR13, CR14, #3, DR14
    BFEXT DR11, DR13, #29, #3
    MCMP DR11, #1
    BRANCHNE proof_bad_pool
    BFEXT DR11, DR13, #25, #2
    MCMP DR11, #3
    BRANCHNE proof_bad_pool
    IADD DR14, DR14, #1
    DWRITE DR14, CR7, #3, DR0
    IADD DR8, DR0, #6
    IADD DR9, DR0, #0
proof_collision:
    MCMP DR9, DR7
    BRANCHHS proof_store
    DREAD DR11, CR7, #1, DR8
    MCMP DR11, DR13
    BRANCHEQ proof_random
    IADD DR9, DR9, #1
    IADD DR8, DR8, #33
    BRANCH proof_collision
proof_store:
    IADD DR10, DR0, #0
proof_copy:
    MCMP DR10, DR6
    BRANCHHS proof_issue
    DREAD DR11, CR2, #2, DR10
    IADD DR12, DR8, DR10
    DWRITE DR11, CR7, #2, DR12
    IADD DR10, DR10, #1
    BRANCH proof_copy
proof_issue:
    DWRITE DR6, CR7, #0, DR8
    DWRITE DR13, CR7, #1, DR8
    DWRITE DR13, CR7, #4, DR0
    LOAD CR1, CR9, #0
    DWRITE DR0, CR7, #4, DR0
    IADD DR7, DR7, #1
    DWRITE DR7, CR7, #1, DR0
    IADD DR1, DR0, #1
    IADD DR2, DR0, #0
    IADD DR3, DR0, #0
    IADD DR4, DR0, #0
    IADD DR6, DR0, #0
    IADD DR7, DR0, #0
    IADD DR8, DR0, #0
    IADD DR9, DR0, #0
    IADD DR10, DR0, #0
    IADD DR11, DR0, #0
    IADD DR12, DR0, #0
    IADD DR13, DR0, #0
    IADD DR14, DR0, #0
    IADD DR15, DR0, #0
    RETURNAL #2
proof_bad_name:
    HARDFAULT "Passkey.NewProof: name must be 1..31 printable non-space ASCII characters"
proof_duplicate:
    HARDFAULT "Passkey.NewProof: name already exists. Existing proof unchanged"
proof_full:
    HARDFAULT "Passkey.NewProof: proof catalogue full"
proof_no_random:
    HARDFAULT "Passkey.NewProof: embedded proof pool exhausted. No proof created"
proof_bad_state:
    HARDFAULT "Passkey.NewProof: invalid provisioned state"
proof_bad_pool:
    HARDFAULT "Passkey.NewProof: invalid embedded Abstract proof word"
}
}
