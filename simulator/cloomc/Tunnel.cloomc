Source for Tunnel  (dot.name)

; Editable FIRST PASS, not source attestation for the released binary.
; Recovered method order: server/lumps/Tunnel.1.8770bf03.lump.
; No installation, boot integration, host protocol or delivery guarantee.
; Current binding verified against ns-state.json AND boot-image.bin raw NS[2]:
; w0=40000014 w1=00000002 w2=DEADF4CF w3=00000000.
; UART_DEV RW => GT 0x32000002, sequence 0, Inform (1), device MMIO R+W.
; Device access is the Turing RW domain, not Church L or E permission.
; This is a programmer-authored permission declaration, not a privileged grant.
; SELF remains compiler-owned cList[0]; UART_DEV is cList[1], NOT NS[11].
; Current UART: TX=0, STATUS=1 (busy=1/ready=0), RX=2.
; Historical RX=1 / TX-status=0 assumptions were incorrect for this device.
; These are raw register accesses: no timeout, FIFO, ACK or framing guarantees.
; DR0 is hardwired zero. DR1 carries the primary result; CR7 is scratch UART.
; RETURN uses the modern implicit continuation; CR5 is instance data, not return.
; -1 below is a local NOT_IMPLEMENTED result, never an on-wire protocol value.

abstraction Tunnel {
    capabilities {
        SELF E
        UART_DEV RW
    }

    ; DR1 boot_reason, DR2 last_fault, DR3 fault_NIA -> DR1 raw RX.
    ; Retains the available three-write body; does not establish a connection,
    ; poll TX readiness, wait for ACK, or guarantee offline-safe boot.
    method Register {
        LOAD CR7, UART_DEV
        DWRITE DR1, CR7, #0
        DWRITE DR2, CR7, #0
        DWRITE DR3, CR7, #0
        DREAD DR1, CR7, #2
        RETURN
    }

    ; DR1 FourCC tag, DR2 count, DR3 payload -> DR1 raw STATUS.
    ; Only the historical single-payload body exists. Reject other counts
    ; locally with -1 and no I/O; multiword Send is NOT IMPLEMENTED.
    ; A ready status is not an acknowledgement of packet delivery.
    method Send {
        ISUB DR4, DR2, #1
        BRANCHNE unsupported
        LOAD CR7, UART_DEV
        DWRITE DR1, CR7, #0
        DWRITE DR2, CR7, #0
        DWRITE DR3, CR7, #0
        DREAD DR1, CR7, #1
        RETURN
    unsupported:
        ISUB DR1, DR0, #1
        RETURN
    }

    ; DR1 timeout hint -> DR1 raw count, DR2 raw tag, DR3 raw first payload.
    ; Preserves the hint write and three reads; these field names describe
    ; the recovered intent only. No blocking, timeout or packet validation.
    method Receive {
        LOAD CR7, UART_DEV
        DWRITE DR1, CR7, #0
        DREAD DR1, CR7, #2
        DREAD DR2, CR7, #2
        DREAD DR3, CR7, #2
        RETURN
    }

    ; DR1 fault_code, DR2 ns_idx, DR3 thread_gt (data word),
    ; DR4 abstr_idx, DR5 method_idx, DR6 instr_offset -> DR1 raw STATUS.
    ; No priority bypass, queueing or transmission guarantee is implemented.
    method Fault {
        LOAD CR7, UART_DEV
        DWRITE DR1, CR7, #0
        DWRITE DR2, CR7, #0
        DWRITE DR3, CR7, #0
        DWRITE DR4, CR7, #0
        DWRITE DR5, CR7, #0
        DWRITE DR6, CR7, #0
        DREAD DR1, CR7, #1
        RETURN
    }

    ; DR1 requested token, DR2 expected_words, CR2 proposed destination.
    ; Retains request writes/read ONLY: DR2 raw RX, DR1=-1 NOT_IMPLEMENTED.
    ; CR2 is not used. Fetch installation, stream receive, size and CRC
    ; checks are NOT IMPLEMENTED. Never report a lump installed.
    method Fetch {
        LOAD CR7, UART_DEV
        DWRITE DR1, CR7, #0
        DWRITE DR2, CR7, #0
        DREAD DR2, CR7, #2
        ISUB DR1, DR0, #1
        RETURN
    }

    ; CR2 proposed remote GT -> DR1=-1 NOT_IMPLEMENTED, no I/O or CALL.
    ; Real remote Call handshake/serialization/correlation is NOT IMPLEMENTED.
    ; Historical TPERM was not permission attenuation; a local CALL plus RX
    ; read does not implement remote invocation. Do not execute that sequence.
    method Call {
        ISUB DR1, DR0, #1
        RETURN
    }
}