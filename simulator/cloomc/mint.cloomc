; MINT PHASE 1 -- CURRENT EDITABLE SOURCE. IMPLEMENTATION IN PROGRESS.
; Language: Assembly
;
; LUMP START: HEADER, THEN METHOD ROUTING TABLE -- ALWAYS.
; The existing LUMP builder emits this prefix ONCE from the methods below:
;   LUMP word 0: header
;   LUMP word 1: CREATE entry       -> CREATE_inputs
;   LUMP word 2: DESTROY entry      -> DESTROY_inputs
;   LUMP word 3: MakeOutform entry  -> MakeOutform_inputs
;   LUMP word 4: MakeInform entry   -> MakeInform_inputs
;   LUMP word 5: CREATE_inputs -- first instruction of CREATE, not a fifth method.
; CREATE's remaining instructions follow its entry.
; DESTROY starts at DESTROY_inputs, addressed by table word 2.
; MakeOutform starts at MakeOutform_inputs, addressed by table word 3.
; MakeInform starts at MakeInform_inputs, addressed by table word 4.
; Those three body addresses depend on emitted method lengths; the builder
; calculates them. No additional unnamed function is declared by this layout.
; Entries are generated body-word offsets in the existing CALL table format.
; Source method indices 0..3 encode CALL selectors 1..4.
; Do not prepend another hand-written table or bypass this one with method 0.
;
; Open File -> mint (cloomc/mint.cloomc).
; This supersedes the obsolete Encode/Revoke/Transfer source, not the live binary.
; Native CLOOMC instruction checks below are real source, not host predicates.
; TODO_* branches deliberately have no destination: compilation MUST fail
; until the corresponding implementation has been reviewed and supplied.
; No default success, no private MINT opcode, no live Namespace installation.
;
; CREATE / DESTROY retain source indices 0 / 1.
; MakeOutform / MakeInform are proposed additional entries, indices 2 / 3.
; Their CR7 target convention is a draft for review, not a deployed ABI.
; Common input: CR2 credential, CR3 DATA R proof (four words at offset zero).
; PkVerify must establish credential type/authority; non-NULL is NOT validity.
; Common output: DR1=1 only after completed body, never assigned by a wrapper.
; CR1 is a non-NULL result GT except DESTROY, which requires architectural NULL.
; Preserve CR5/DR5 and architectural CR12..15 rules. DR2..4 are scratch.
; TODO_<Method>_FINISH must clear other caller-clobbered CRs/DRs before entering
; each *_result label; retain result CR1 and completion DR1 for checking.
; This draft checks available NULL/permission/scalar shapes only. Exact GT
; type, residency, provenance, proof and object-specific output checks are
; explicit unresolved gates, not silently assumed to pass.

abstraction ide.Mint {
capabilities { SELF E }

method CREATE {
CREATE_inputs:
    ; CR4: 12-word request; CR8: optional initial content; CR7: NULL.
    TPERM CR1, CLEAR
    IADD DR1, DR0, #0
    TPERM CR2, NULL
    BRANCHEQ TODO_CREATE_INPUT_CREDENTIAL_NULL
    TPERM CR3, R
    BRANCHNE TODO_CREATE_INPUT_PROOF_READ
    DREAD DR2, CR3, #3
    TPERM CR4, R
    BRANCHNE TODO_CREATE_INPUT_REQUEST_READ
    DREAD DR2, CR4, #11
    MCMP DR2, #0
    BRANCHNE TODO_CREATE_INPUT_RESERVED_WORD11
    DREAD DR2, CR4, #10
    MCMP DR2, #0
    BRANCHNE TODO_CREATE_INPUT_RESERVED_WORD10
    TPERM CR7, NULL
    BRANCHNE TODO_CREATE_INPUT_CR7_NOT_NULL
    ; Interface version 0x101.
    DREAD DR2, CR4, #0
    MCMP DR2, #257
    BRANCHNE TODO_CREATE_INPUT_INTERFACE_VERSION
    ; Object kind 1..8; GT type 1..3.
    DREAD DR2, CR4, #1
    MCMP DR2, #1
    BRANCHCC TODO_CREATE_INPUT_KIND_LOW
    MCMP DR2, #8
    BRANCHHI TODO_CREATE_INPUT_KIND_HIGH
    DREAD DR2, CR4, #2
    MCMP DR2, #1
    BRANCHCC TODO_CREATE_INPUT_TYPE_LOW
    MCMP DR2, #3
    BRANCHHI TODO_CREATE_INPUT_TYPE_HIGH
    ; Domain and B each 0..1; permissions 0..7; Owner 0..15.
    DREAD DR2, CR4, #3
    MCMP DR2, #1
    BRANCHHI TODO_CREATE_INPUT_DOMAIN
    DREAD DR2, CR4, #4
    MCMP DR2, #7
    BRANCHHI TODO_CREATE_INPUT_PERMISSIONS
    DREAD DR2, CR4, #5
    MCMP DR2, #1
    BRANCHHI TODO_CREATE_INPUT_BIND_FLAG
    DREAD DR2, CR4, #8
    MCMP DR2, #15
    BRANCHHI TODO_CREATE_INPUT_OWNER
    ; A zero-length payload requires NULL; a nonzero length requires DATA R.
    DREAD DR2, CR4, #7
    MCMP DR2, #0
    BRANCHEQ create_empty_payload
    TPERM CR8, R
    BRANCHNE TODO_CREATE_INPUT_PAYLOAD_READ
    BRANCH create_specific_checks
create_empty_payload:
    TPERM CR8, NULL
    BRANCHNE TODO_CREATE_INPUT_EMPTY_PAYLOAD_NOT_NULL
create_specific_checks:
    ; Kind 1..5 => Inform; 6 => Outform; 7..8 => Abstract.
    DREAD DR2, CR4, #1
    DREAD DR3, CR4, #2
    MCMP DR2, #6
    BRANCHEQ create_outform_request
    BRANCHHI create_abstract_request
    MCMP DR3, #1
    BRANCHNE TODO_CREATE_INPUT_KIND_REQUIRES_INFORM
    DREAD DR3, CR4, #6
    MCMP DR3, #0
    BRANCHEQ TODO_CREATE_INPUT_ALLOCATION_ZERO
    DREAD DR4, CR4, #7
    MCMP DR4, DR3
    BRANCHHI TODO_CREATE_INPUT_PAYLOAD_EXCEEDS_ALLOCATION
    MCMP DR2, #1
    BRANCHEQ create_reference_fields
    MCMP DR4, #0
    BRANCHEQ TODO_CREATE_INPUT_COMPLETE_OBJECT_MISSING
    BRANCH create_reference_fields
create_outform_request:
    MCMP DR3, #2
    BRANCHNE TODO_CREATE_INPUT_KIND_REQUIRES_OUTFORM
    DREAD DR3, CR4, #6
    MCMP DR3, #0
    BRANCHNE TODO_CREATE_INPUT_OUTFORM_ALLOCATION_NOT_ZERO
    DREAD DR3, CR4, #7
    MCMP DR3, #4
    BRANCHNE TODO_CREATE_INPUT_OUTFORM_DESCRIPTOR_LENGTH
create_reference_fields:
    DREAD DR3, CR4, #8
    MCMP DR3, #0
    BRANCHNE TODO_CREATE_INPUT_UNUSED_OWNER_NOT_ZERO
    DREAD DR3, CR4, #9
    MCMP DR3, #0
    BRANCHNE TODO_CREATE_INPUT_UNUSED_ABSTRACT_PAYLOAD_NOT_ZERO
    BRANCH create_typed_checks
create_abstract_request:
    MCMP DR3, #3
    BRANCHNE TODO_CREATE_INPUT_KIND_REQUIRES_ABSTRACT
    DREAD DR3, CR4, #3
    MCMP DR3, #0
    BRANCHNE TODO_CREATE_INPUT_ABSTRACT_DOMAIN_NOT_ZERO
    DREAD DR3, CR4, #4
    MCMP DR3, #0
    BRANCHNE TODO_CREATE_INPUT_ABSTRACT_PERMISSIONS_NOT_ZERO
    DREAD DR3, CR4, #6
    MCMP DR3, #0
    BRANCHNE TODO_CREATE_INPUT_ABSTRACT_ALLOCATION_NOT_ZERO
    DREAD DR3, CR4, #9
    SHR DR3, DR3, #25
    MCMP DR3, #0
    BRANCHNE TODO_CREATE_INPUT_ABSTRACT_PAYLOAD_OVER_25_BITS
create_typed_checks:
    ; Still requires actual GT-type, full payload bounds, object geometry,
    ; and hierarchy-specific input checks; scalar checks do not confer authority.
    BRANCH TODO_CREATE_TYPED_INPUTS
create_authorize:
    BRANCH TODO_CREATE_PKVERIFY
create_body:
    ; Allocate/issue actual GT, register with GC, put GT in CR1, set DR1=1.
    BRANCH TODO_CREATE_BODY
create_finish:
    BRANCH TODO_CREATE_FINISH
create_result:
    MCMP DR1, #1
    BRANCHNE TODO_CREATE_RESULT_COMPLETION
    TPERM CR1, NULL
    BRANCHEQ TODO_CREATE_RESULT_NULL
    ; Verify issued type/rights/identity against the frozen request.
    BRANCH TODO_CREATE_RESULT_TYPE
create_return:
    RETURNAL #2
}

method DESTROY {
DESTROY_inputs:
    ; CR7: target. Resident and Outform objects MUST be rejected before mutation.
    ; CR4/CR8: NULL. Result CR1: NULL; DR1: completed destruction.
    TPERM CR1, CLEAR
    IADD DR1, DR0, #0
    TPERM CR2, NULL
    BRANCHEQ TODO_DESTROY_INPUT_CREDENTIAL_NULL
    TPERM CR3, R
    BRANCHNE TODO_DESTROY_INPUT_PROOF_READ
    DREAD DR2, CR3, #3
    TPERM CR7, NULL
    BRANCHEQ TODO_DESTROY_INPUT_TARGET_NULL
    TPERM CR4, NULL
    BRANCHNE TODO_DESTROY_INPUT_CR4_NOT_NULL
    TPERM CR8, NULL
    BRANCHNE TODO_DESTROY_INPUT_CR8_NOT_NULL
    BRANCH TODO_DESTROY_REJECT_RESIDENT_AND_OUTFORM
destroy_authorize:
    BRANCH TODO_DESTROY_PKVERIFY_AND_ACTIVE_USE
destroy_body:
    ; Kill eligible object, increment released-slot version before freeing,
    ; zero storage before reuse and update shared Mint/GC records once.
    BRANCH TODO_DESTROY_BODY
destroy_finish:
    BRANCH TODO_DESTROY_FINISH
destroy_result:
    MCMP DR1, #1
    BRANCHNE TODO_DESTROY_RESULT_COMPLETION
    TPERM CR1, NULL
    BRANCHNE TODO_DESTROY_RESULT_NOT_NULL
    RETURNAL #0
}

method MakeOutform {
MakeOutform_inputs:
    ; Proposed input: CR7 eligible live object, CR4/CR8 NULL.
    ; Result CR1: Outform for SAME object, not a replacement identity.
    TPERM CR1, CLEAR
    IADD DR1, DR0, #0
    TPERM CR2, NULL
    BRANCHEQ TODO_MakeOutform_INPUT_CREDENTIAL_NULL
    TPERM CR3, R
    BRANCHNE TODO_MakeOutform_INPUT_PROOF_READ
    DREAD DR2, CR3, #3
    TPERM CR7, NULL
    BRANCHEQ TODO_MakeOutform_INPUT_TARGET_NULL
    TPERM CR4, NULL
    BRANCHNE TODO_MakeOutform_INPUT_CR4_NOT_NULL
    TPERM CR8, NULL
    BRANCHNE TODO_MakeOutform_INPUT_CR8_NOT_NULL
    BRANCH TODO_MakeOutform_INPUT_TYPE_AND_AUTHORITY
outform_body:
    ; Preserve identity and backing representation before any local release.
    BRANCH TODO_MakeOutform_BODY
outform_finish:
    BRANCH TODO_MakeOutform_FINISH
outform_result:
    MCMP DR1, #1
    BRANCHNE TODO_MakeOutform_RESULT_COMPLETION
    TPERM CR1, NULL
    BRANCHEQ TODO_MakeOutform_RESULT_NULL
    BRANCH TODO_MakeOutform_RESULT_TYPE_AND_IDENTITY
outform_return:
    RETURNAL #2
}

method MakeInform {
MakeInform_inputs:
    ; Proposed input: CR7 Outform, CR4/CR8 NULL.
    ; Result CR1: Inform for SAME live object. Never resurrect a dead object.
    TPERM CR1, CLEAR
    IADD DR1, DR0, #0
    TPERM CR2, NULL
    BRANCHEQ TODO_MakeInform_INPUT_CREDENTIAL_NULL
    TPERM CR3, R
    BRANCHNE TODO_MakeInform_INPUT_PROOF_READ
    DREAD DR2, CR3, #3
    TPERM CR7, NULL
    BRANCHEQ TODO_MakeInform_INPUT_TARGET_NULL
    TPERM CR4, NULL
    BRANCHNE TODO_MakeInform_INPUT_CR4_NOT_NULL
    TPERM CR8, NULL
    BRANCHNE TODO_MakeInform_INPUT_CR8_NOT_NULL
    BRANCH TODO_MakeInform_REQUIRE_OUTFORM_AND_AUTHORITY
inform_body:
    ; Resolve live object, bind retained destination generation, register GC.
    BRANCH TODO_MakeInform_BODY
inform_finish:
    BRANCH TODO_MakeInform_FINISH
inform_result:
    MCMP DR1, #1
    BRANCHNE TODO_MakeInform_RESULT_COMPLETION
    TPERM CR1, NULL
    BRANCHEQ TODO_MakeInform_RESULT_NULL
    BRANCH TODO_MakeInform_RESULT_TYPE_AND_IDENTITY
inform_return:
    RETURNAL #2
}
}
