; MINT PHASE 1 -- CURRENT EDITABLE SOURCE. IMPLEMENTATION IN PROGRESS.
; Language: Assembly
;
; LUMP START: HEADER, THEN METHOD ROUTING TABLE -- ALWAYS.
; The existing LUMP builder emits this prefix ONCE from the methods below:
;   LUMP word 0: header
;   LUMP word 1: CREATE entry       -> CREATE_inputs
;   LUMP word 2: DESTROY entry      -> DESTROY_inputs
;   LUMP word 3: MakeOutform entry  -> MakeOutform_inputs
;   LUMP word 4: MakeInform entry   -> MakeInform_inputs
;   LUMP word 5: CREATE_inputs -- first instruction of CREATE, not a fifth method.
; CREATE's remaining instructions follow its entry.
; DESTROY starts at DESTROY_inputs, addressed by table word 2.
; MakeOutform starts at MakeOutform_inputs, addressed by table word 3.
; MakeInform starts at MakeInform_inputs, addressed by table word 4.
; Those three body addresses depend on emitted method lengths; the builder
; calculates them. No additional unnamed function is declared by this layout.
; Entries are generated body-word offsets in the existing CALL table format.
; Source method indices 0..3 encode CALL selectors 1..4.
; Do not prepend another hand-written table or bypass this one with method 0.
;
; Open File -> mint (cloomc/mint.cloomc).
; This supersedes the obsolete Encode/Revoke/Transfer source, not the live binary.
; Native CLOOMC instruction checks below are real source, not host predicates.
; Fault-only TODO labels below now have explicit HARDFAULT destinations.
; Their names are retained to match the reviewed pseudocode.
; Operation TODOs still have no destination: compilation MUST fail until
; the corresponding implementation has been reviewed and supplied.
; HARDFAULT emits the agreed word with signed compiler-site metadata for
; exact saved-artifact attribution. Never substitute HALT or a reporting CALL.
; No default success, no private MINT opcode, no live Namespace installation.
;
; CREATE / DESTROY retain source indices 0 / 1.
; MakeOutform / MakeInform are proposed additional entries, indices 2 / 3.
; Their CR7 target convention is a draft for review, not a deployed ABI.
; Common input: CR2 credential, CR3 DATA R proof (four words at offset zero).
; Phase 1 PkVerify always approves; real credential/proof verification is deferred.
; Common output: DR1=1 only after completed body, never assigned by a wrapper.
; CR1 is a non-NULL result GT except DESTROY, which requires architectural NULL.
; Preserve CR5/DR5 and architectural CR12..15 rules.
; CREATE consumes packed DR2 and permission mask DR3 before using scratch.
; FINISH enters final result validation before erasing its working evidence.
; After validation, each *_return clears DR2..4 and DR6..15 with IADD from DR0.
; DR1 is the completion output; preserve DR5 (Thread heap pointer) and DR0.
; CALL-frame RETURN keep masks erase CR0..4/CR7..11 (and their Thread homes):
; #2 retains only CR1; #0 retains none. CR5 is preserved, CR6 reconstructed.
; These masks complete outward capability cleanup, not the early *_CLEAR_* gates.
; LAMBDA-frame RETURN preserves ALL CRs, regardless of mask: same context,
; not a CALL security boundary. It CANNOT implement any early cleanup helper.
; Early result/proof/private-authority clearing still needs a legal mechanism.
; LOAD CRd, NULL discards authority; zero-permission attenuation does not.
; Do not replace these gates with TPERM CLEAR, host writes or an invented opcode.
; This draft checks available NULL/permission/scalar shapes only. Exact GT
; type, residency, provenance, proof and object-specific output checks are
; explicit unresolved gates, not silently assumed to pass.

abstraction ide.Mint {
capabilities { SELF E, ide.MintState RW, ide.MintState L, ide.MintPool RW, ide.PkVerify E }

method CREATE {
CREATE_inputs:
    ; First implementation slice: case 4, DATA RW only.
    ; CR2/CR3: Passkey GT/proof. CR4: NULL; Data has no source payload.
    ; Allocate separate storage and zero EVERY word before issuing its GT.
    ; DR2 = power-of-two word size | 4 (low three bits).
    ; DR3 = 3: DATA permission bits W|R, NOT TPERM preset number 2.
    ; Other cases/permissions remain unsupported, never silently become Data.
    ; TPERM CLEAR tests presence; it does NOT erase a capability.
    LOAD CR1, NULL
create_data_inputs_after_clear:
    IADD DR1, DR0, #0
create_data_passkey_escape:
    ; Private state LUMP views come from Mint's own C-list, never from
    ; the caller. Its sole c-list row is scratch at the last LUMP word.
    LOAD CR8, CR6, #1
    LOAD CR7, CR6, #2
    DREAD DR9, CR8, #0
    BFEXT DR9, DR9, #23, #4
    IADD DR10, DR0, #64
create_data_state_size:
    MCMP DR9, #0
    BRANCHEQ create_data_escape_reference
    SHL DR10, DR10, #1
    ISUB DR9, DR9, #1
    BRANCH create_data_state_size
create_data_escape_reference:
    ISUB DR10, DR10, #1
    ISUB DR9, DR0, #1
    DWRITE DR9, CR8, #0, DR10
    LOAD CR11, CR7, #0
    ; Existing EXACT instruction: only the exact all-ones CR2 escapes.
    ; No proof read or CR3 requirement on this Phase 1 testing path.
    TPERM CR2, EXACT, CR11
    BRANCHEQ create_data_source_checks
    TPERM CR2, NULL
    BRANCHEQ TODO_CREATE_INPUT_CREDENTIAL_NULL
    TPERM CR3, R
    BRANCHNE TODO_CREATE_INPUT_PROOF_READ
    ; Probe proof bounds without clobbering packed DR2 or permission DR3.
    DREAD DR4, CR3, #3
create_data_source_checks:
    TPERM CR4, NULL
    BRANCHNE TODO_CREATE_INPUT_DATA_SOURCE_NOT_NULL
create_data_scalar_checks:
    BFEXT DR4, DR2, #0, #3
    MCMP DR4, #4
    BRANCHNE TODO_CREATE_INPUT_CASE_NOT_DATA
    MCMP DR3, #3
    BRANCHNE TODO_CREATE_INPUT_PERMISSIONS_NOT_RW
    IADD DR6, DR2, #0
    BFINS DR6, DR0, #0, #3
    MCMP DR6, #0
    BRANCHEQ TODO_CREATE_INPUT_ALLOCATION_ZERO
    ; Exact power of two: shift until one, rejecting any earlier odd value.
    ; No unapproved 64-word minimum is enforced here.
    IADD DR7, DR6, #0
create_data_power_loop:
    MCMP DR7, #1
    BRANCHEQ create_data_authorize
    BFEXT DR4, DR7, #0, #1
    MCMP DR4, #0
    BRANCHNE TODO_CREATE_INPUT_SIZE_NOT_POWER_TWO
    SHR DR7, DR7, #1
    BRANCH create_data_power_loop
create_data_authorize:
    ; Call Verify through Mint's own E capability, including the Phase 1
    ; test-credential path. Source method 0 uses CALL selector 1.
    LOAD CR1, CR6, #4
    CALL CR1, #0
    MCMP DR1, #1
    BRANCHNE TODO_CREATE_PKVERIFY_NOT_APPROVED
    ; Phase 1 uses PkVerify APPROVED as allocation approval: no separate quota gate.
    ; Approval is not completed CREATE; pool/slot capacity checks still follow.
    ; PkVerify preserves requested size DR6 and credential/proof CR2/CR3.
    IADD DR1, DR0, #0
    BRANCH create_data_allocate
create_data_allocate:
    ; Mint-owned state payload (word 0 remains the LUMP header):
    ; 1 pool cursor, 2 exclusive pool end, 3 free-slot queue cursor,
    ; 4 exclusive queue end, 5 physical BYTE base of MintPool's RW view,
    ; 6 history-table offset; queue starts at >=7 and ends before history.
    ; history[slot]: bits 0..8 current sequence, bit9 never-used,
    ; bit10 reserved (reject reuse), all higher bits zero.
    ; Trusted provisioning must bind word5 to the actual pool capability,
    ; exclude pool metadata and supply authoritative history, not infer it
    ; from an empty Namespace entry. No caller-supplied base/history.
    ; Single-threaded bump allocation; no reclamation policy is implied.
    ; All checks/reads precede reservation writes. Exhaustion is a hard fault.
    LOAD CR7, CR6, #1
    LOAD CR8, CR6, #3
    IADD DR1, DR0, #0
    MCMP DR6, #0
    BRANCHEQ TODO_CREATE_DESCRIPTOR_INPUT_INVALID
    ISUB DR4, DR6, #1
    BFEXT DR4, DR4, #21, #11
    MCMP DR4, #0
    BRANCHNE TODO_CREATE_DESCRIPTOR_INPUT_INVALID
    DREAD DR8, CR7, #1
    DREAD DR10, CR7, #2
    MCMP DR8, DR10
    BRANCHHI TODO_CREATE_ALLOCATOR_STATE
    ISUB DR10, DR10, DR8
    MCMP DR6, DR10
    BRANCHHI TODO_CREATE_POOL_EXHAUSTED
    DREAD DR9, CR7, #3
    MCMP DR9, #7
    BRANCHLO TODO_CREATE_ALLOCATOR_STATE
    DREAD DR10, CR7, #4
    MCMP DR9, DR10
    BRANCHHS TODO_CREATE_SLOTS_EXHAUSTED
    DREAD DR4, CR7, #6
    MCMP DR10, DR4
    BRANCHHI TODO_CREATE_ALLOCATOR_STATE
    DREAD DR7, CR7, #0, DR9
    BFEXT DR4, DR7, #16, #16
    MCMP DR4, #0
    BRANCHNE TODO_CREATE_ALLOCATOR_STATE
    MCMP DR7, #2
    BRANCHLO TODO_CREATE_ALLOCATOR_STATE
    ; Probe the complete pool interval before advancing either cursor.
    ; DR6 is already checked nonzero; available-space subtraction above
    ; prevents cursor addition overflow for valid unsigned state.
    IADD DR10, DR8, DR6
    ISUB DR11, DR10, #1
    DREAD DR4, CR8, #0, DR8
    DREAD DR4, CR8, #0, DR11
    ; Validate physical end (inclusive last word), without shift/add wrap.
    BFEXT DR4, DR11, #30, #2
    MCMP DR4, #0
    BRANCHNE TODO_CREATE_ALLOCATOR_STATE
    DREAD DR2, CR7, #5
    BFEXT DR4, DR2, #0, #2
    MCMP DR4, #0
    BRANCHNE TODO_CREATE_ALLOCATOR_STATE
    SHL DR11, DR11, #2
    IADD DR11, DR11, DR2
    MCMP DR11, DR2
    BRANCHLO TODO_CREATE_ALLOCATOR_STATE
    SHL DR8, DR8, #2
    IADD DR8, DR8, DR2
    ; History indexed by slot, NOT by free-queue position. Duplicate queue
    ; entries cannot turn a reserved slot back into a never-used slot.
    DREAD DR9, CR7, #6
    IADD DR10, DR9, DR7
    MCMP DR10, DR9
    BRANCHLO TODO_CREATE_ALLOCATOR_STATE
    DREAD DR2, CR7, #0, DR10
    BFEXT DR4, DR2, #10, #22
    MCMP DR4, #0
    BRANCHNE TODO_CREATE_ALLOCATOR_STATE
    BFEXT DR3, DR2, #9, #1
    BFEXT DR2, DR2, #0, #9
    BRANCH create_data_publish
create_data_zero_begin:
    ; Package succeeded. Consume history before advancing either cursor:
    ; a later fault may leak a reservation, never reuse its authority.
    DREAD DR13, CR7, #6
    IADD DR13, DR13, DR7
    BFEXT DR2, DR9, #21, #9
    IADD DR3, DR0, #1
    BFINS DR2, DR3, #10, #1
    DWRITE DR2, CR7, #0, DR13
    DREAD DR13, CR7, #1
    IADD DR14, DR13, DR6
    DWRITE DR14, CR7, #1
    DREAD DR15, CR7, #3
    IADD DR15, DR15, #1
    DWRITE DR15, CR7, #3
create_data_zero_loop:
    MCMP DR13, DR14
    BRANCHEQ create_data_set_slot
    DWRITE DR0, CR8, #0, DR13
    IADD DR13, DR13, #1
    BRANCH create_data_zero_loop
create_data_publish:
    ; Inputs now come from the native allocator and Mint-owned history.
    BRANCH create_descriptor_prepare
create_data_descriptor_ready:
    MCMP DR12, #1
    BRANCHNE create_data_retire_slot
    IADD DR1, DR0, #0
    BRANCH create_data_zero_begin
create_data_retire_slot:
    ; Durable within MintState: retries see 511, never wrap or allocate.
    ; Leave queue/pool cursors and pool bytes unchanged; no auto-skip policy.
    DREAD DR13, CR7, #6
    IADD DR13, DR13, DR7
    DWRITE DR4, CR7, #0, DR13
    BRANCH TODO_CREATE_DESCRIPTOR_RETIRED

; BEGIN NATIVE SLOT PACKAGE -- private same-context blocks, no extra GT.
; Inputs: DR8 physical byte address, DR6 nonzero word count, DR7 slot >= 2,
;         DR2 current 9-bit version, DR3 never-used boolean from slot history.
; Success: DR8..11 = W0..3, DR12 = 1. DR1 remains CREATE-incomplete (0).
; Retired: DR12 = 0, DR4 = 511, W1..3 = 0; no storage retirement is performed.
; Preserves DR5 (heap), DR6, DR7, DR8 and ALL CRs. Other DRs/flags are scratch.
; No memory writes, Namespace reads, CALL, CHANGE, SWITCH or opcode-7 frame.
create_descriptor_prepare:
    IADD DR1, DR0, #0
    IADD DR9, DR0, #0
    IADD DR10, DR0, #0
    IADD DR11, DR0, #0
    IADD DR12, DR0, #0
    MCMP DR6, #0
    BRANCHEQ TODO_CREATE_DESCRIPTOR_INPUT_INVALID
    ISUB DR9, DR6, #1
    BFEXT DR4, DR9, #21, #11
    MCMP DR4, #0
    BRANCHNE TODO_CREATE_DESCRIPTOR_INPUT_INVALID
    BFEXT DR4, DR8, #0, #2
    MCMP DR4, #0
    BRANCHNE TODO_CREATE_DESCRIPTOR_INPUT_INVALID
    BFEXT DR4, DR7, #16, #16
    MCMP DR4, #0
    BRANCHNE TODO_CREATE_DESCRIPTOR_INPUT_INVALID
    MCMP DR7, #2
    BRANCHLT TODO_CREATE_DESCRIPTOR_INPUT_INVALID
    BFEXT DR4, DR2, #9, #23
    MCMP DR4, #0
    BRANCHNE TODO_CREATE_DESCRIPTOR_INPUT_INVALID
    MCMP DR3, #1
    BRANCHHI TODO_CREATE_DESCRIPTOR_INPUT_INVALID
    BRANCH create_descriptor_next_sequence

create_descriptor_after_sequence:
    BFINS DR9, DR4, #21, #9
    BFINS DR9, DR0, #30, #2
    ; T === issued GT: slot[15:0], seq[24:16], Inform=01, dom=0,
    ; DATA RW=011, B=1. The high seven bits are therefore 0b1011001.
    IADD DR11, DR7, #0
    BFINS DR11, DR4, #16, #9
    IADD DR12, DR0, #89
    BFINS DR11, DR12, #25, #7
    BRANCH create_descriptor_integrity

create_descriptor_after_integrity:
    IADD DR1, DR0, #0
    IADD DR12, DR0, #1
    BRANCH create_descriptor_done

; Private sequence Lambda: one local invocation, fixed local continuation.
create_descriptor_next_sequence:
    MCMP DR2, #510
    BRANCHGE create_descriptor_retired
    MCMP DR3, #0
    BRANCHNE create_descriptor_first_use
    IADD DR4, DR2, #1
    BRANCH create_descriptor_after_sequence
create_descriptor_first_use:
    ; A never-used slot has initial version zero, never an arbitrary history.
    MCMP DR2, #0
    BRANCHNE TODO_CREATE_DESCRIPTOR_INPUT_INVALID
    IADD DR4, DR0, #0
    BRANCH create_descriptor_after_sequence
create_descriptor_retired:
    IADD DR4, DR0, #511
    IADD DR9, DR0, #0
    BRANCH create_descriptor_done

; Private integrity Lambda: W0/W1 unchanged; W2 in DR10.
; ROL32(W0,7), using only existing shift/bitfield instructions.
create_descriptor_integrity:
    BFEXT DR12, DR8, #25, #7
    SHL DR13, DR8, #7
    BFINS DR13, DR12, #0, #7
    ; ROL32(W1 & 0x3FFFFFFF,13).
    IADD DR14, DR9, #0
    BFINS DR14, DR0, #30, #2
    BFEXT DR12, DR14, #19, #13
    SHL DR14, DR14, #13
    BFINS DR14, DR12, #0, #13
    ; Construct 0xDEADBEEF without a new large-immediate instruction.
    IADD DR15, DR0, #222
    SHL DR15, DR15, #8
    IADD DR15, DR15, #173
    SHL DR15, DR15, #8
    IADD DR15, DR15, #190
    SHL DR15, DR15, #8
    IADD DR15, DR15, #239
    IADD DR10, DR0, #0
    IADD DR4, DR0, #32
create_descriptor_xor_bits:
    ; XOR of three bits is their sum modulo two. No invented XOR opcode.
    BFEXT DR1, DR13, #0, #1
    BFEXT DR2, DR14, #0, #1
    BFEXT DR3, DR15, #0, #1
    IADD DR1, DR1, DR2
    IADD DR1, DR1, DR3
    SHR DR10, DR10, #1
    BFINS DR10, DR1, #31, #1
    SHR DR13, DR13, #1
    SHR DR14, DR14, #1
    SHR DR15, DR15, #1
    ISUB DR4, DR4, #1
    ; Register-form MCMP preserves live DR15. Immediate MCMP lowering uses
    ; DR15 as scratch and would corrupt the remaining XOR constant bits.
    MCMP DR4, DR0
    BRANCHNE create_descriptor_xor_bits
    BRANCH create_descriptor_after_integrity
create_descriptor_done:
    BRANCH create_data_descriptor_ready
; END NATIVE SLOT PACKAGE

create_data_set_slot:
    ; Single local call site: ordinary branches use the unchanged CR14.
    ; No separate X GT, CALL frame, LAMBDA frame or new operand encoding.
    BRANCH create_data_slot_lambda
create_data_slot_after_clear:
    ; Same Mint context, single-threaded Phase 1: retain private authority.
create_data_account_and_issue:
    ; Service binding missing: finish GC/accounting after confirmed slot writes,
    ; debit exactly DR6 words once, issue Inform DATA RW B=1 in CR1.
    ; Only completed publication may set DR1=1. No rollback is promised.
    BRANCH TODO_CREATE_COMMIT_ACCOUNT_AND_ISSUE
create_finish:
    ; Validate the result before erasing descriptor/accounting evidence.
create_result:
    MCMP DR1, #1
    BRANCHNE TODO_CREATE_RESULT_COMPLETION
    TPERM CR1, NULL
    BRANCHEQ TODO_CREATE_RESULT_NULL
    TPERM CR1, RW
    BRANCHNE TODO_CREATE_RESULT_NOT_RW
    ; Verify Inform DATA, B=1, and exact committed allocation identity.
    BRANCH TODO_CREATE_RESULT_TYPE
create_return:
    IADD DR2, DR0, #0
    IADD DR3, DR0, #0
    IADD DR4, DR0, #0
    IADD DR6, DR0, #0
    IADD DR7, DR0, #0
    IADD DR8, DR0, #0
    IADD DR9, DR0, #0
    IADD DR10, DR0, #0
    IADD DR11, DR0, #0
    IADD DR12, DR0, #0
    IADD DR13, DR0, #0
    IADD DR14, DR0, #0
    IADD DR15, DR0, #0
    RETURNAL #2

create_data_slot_lambda:
    ; Private same-scope local block, NOT a public method or an E-GT CALL.
    ; Only this body may acquire the configured Namespace RW view in CR10.
    ; Validate frozen Namespace identity, DR7 slot bounds, empty-slot generation
    ; and all four prepared words against the authorized reservation.
    ; Hold the required writer/observer exclusion through read-back and cleanup;
    ; LAMBDA alone does not provide atomicity. No CALL/CHANGE/SWITCH in interval.
    BRANCH TODO_CREATE_SLOT_BIND_VALIDATE_AND_EXCLUDE
create_data_slot_offset:
    SHL DR7, DR7, #2
create_data_slot_write:
    DWRITE DR8, CR10, #0, DR7
    DWRITE DR9, CR10, #1, DR7
    DWRITE DR10, CR10, #2, DR7
    DWRITE DR11, CR10, #3, DR7
    DREAD DR4, CR10, #0, DR7
    MCMP DR4, DR8
    BRANCHNE TODO_CREATE_SLOT_CONFIRM_WORD0
    DREAD DR4, CR10, #1, DR7
    MCMP DR4, DR9
    BRANCHNE TODO_CREATE_SLOT_CONFIRM_WORD1
    DREAD DR4, CR10, #2, DR7
    MCMP DR4, DR10
    BRANCHNE TODO_CREATE_SLOT_CONFIRM_WORD2
    DREAD DR4, CR10, #3, DR7
    MCMP DR4, DR11
    BRANCHNE TODO_CREATE_SLOT_CONFIRM_WORD3
create_data_slot_return:
    ; This block has one entry site and a fixed local continuation.
    ; Do not consume the enclosing CALL frame or clear any CR.
    BRANCH create_data_slot_after_clear

; Resolved failure cases. No result issuance and no promised rollback.
TODO_CREATE_PKVERIFY_NOT_APPROVED:
    HARDFAULT "Mint.CREATE: PkVerify did not return APPROVED"
TODO_CREATE_DESCRIPTOR_INPUT_INVALID:
    HARDFAULT "Mint.CREATE: invalid allocator or slot-history input for descriptor"
TODO_CREATE_DESCRIPTOR_RETIRED:
    HARDFAULT "Mint.CREATE: selected slot is retired and cannot be allocated"
TODO_CREATE_INPUT_CREDENTIAL_NULL:
    HARDFAULT "Mint.CREATE: missing Passkey"
TODO_CREATE_INPUT_PROOF_READ:
    HARDFAULT "Mint.CREATE: proof capability is not readable"
TODO_CREATE_INPUT_DATA_SOURCE_NOT_NULL:
    HARDFAULT "Mint.CREATE: DATA source CR4 must be NULL"
TODO_CREATE_INPUT_CASE_NOT_DATA:
    HARDFAULT "Mint.CREATE: only DATA case is implemented"
TODO_CREATE_INPUT_PERMISSIONS_NOT_RW:
    HARDFAULT "Mint.CREATE: DATA permissions must be READ/WRITE"
TODO_CREATE_INPUT_ALLOCATION_ZERO:
    HARDFAULT "Mint.CREATE: allocation size is zero"
TODO_CREATE_INPUT_SIZE_NOT_POWER_TWO:
    HARDFAULT "Mint.CREATE: allocation size is not a power of two"
TODO_CREATE_ALLOCATOR_STATE:
    HARDFAULT "Mint.CREATE: inconsistent allocator state"
TODO_CREATE_POOL_EXHAUSTED:
    HARDFAULT "Mint.CREATE: memory pool exhausted"
TODO_CREATE_SLOTS_EXHAUSTED:
    HARDFAULT "Mint.CREATE: free Namespace slots exhausted"
TODO_CREATE_RESULT_COMPLETION:
    HARDFAULT "Mint.CREATE: operation did not complete"
TODO_CREATE_RESULT_NULL:
    HARDFAULT "Mint.CREATE: result capability is NULL"
TODO_CREATE_RESULT_NOT_RW:
    HARDFAULT "Mint.CREATE: result lacks READ/WRITE permissions"
TODO_CREATE_SLOT_CONFIRM_WORD0:
    HARDFAULT "Mint.CREATE: Namespace location read-back mismatch"
TODO_CREATE_SLOT_CONFIRM_WORD1:
    HARDFAULT "Mint.CREATE: Namespace bounds/version read-back mismatch"
TODO_CREATE_SLOT_CONFIRM_WORD2:
    HARDFAULT "Mint.CREATE: Namespace integrity read-back mismatch"
TODO_CREATE_SLOT_CONFIRM_WORD3:
    HARDFAULT "Mint.CREATE: Namespace identity read-back mismatch"
}

method DESTROY {
DESTROY_inputs:
    ; CR7: target. Resident and Outform objects MUST be rejected before mutation.
    ; CR4/CR8: NULL. Result CR1: NULL; DR1: completed destruction.
    BRANCH TODO_DESTROY_CLEAR_RESULT_AUTHORITY
destroy_inputs_after_clear:
    IADD DR1, DR0, #0
    TPERM CR2, NULL
    BRANCHEQ TODO_DESTROY_INPUT_CREDENTIAL_NULL
    TPERM CR3, R
    BRANCHNE TODO_DESTROY_INPUT_PROOF_READ
    DREAD DR2, CR3, #3
    TPERM CR7, NULL
    BRANCHEQ TODO_DESTROY_INPUT_TARGET_NULL
    TPERM CR4, NULL
    BRANCHNE TODO_DESTROY_INPUT_CR4_NOT_NULL
    TPERM CR8, NULL
    BRANCHNE TODO_DESTROY_INPUT_CR8_NOT_NULL
    BRANCH TODO_DESTROY_REJECT_RESIDENT_AND_OUTFORM
destroy_authorize:
    BRANCH TODO_DESTROY_PKVERIFY_AND_ACTIVE_USE
destroy_body:
    ; Kill eligible object; retain issued version on release (CREATE increments),
    ; zero storage before reuse and update shared Mint/GC records once.
    BRANCH TODO_DESTROY_BODY
destroy_finish:
    ; Validate completion and NULL result before outward cleanup.
destroy_result:
    MCMP DR1, #1
    BRANCHNE TODO_DESTROY_RESULT_COMPLETION
    TPERM CR1, NULL
    BRANCHNE TODO_DESTROY_RESULT_NOT_NULL
destroy_return:
    IADD DR2, DR0, #0
    IADD DR3, DR0, #0
    IADD DR4, DR0, #0
    IADD DR6, DR0, #0
    IADD DR7, DR0, #0
    IADD DR8, DR0, #0
    IADD DR9, DR0, #0
    IADD DR10, DR0, #0
    IADD DR11, DR0, #0
    IADD DR12, DR0, #0
    IADD DR13, DR0, #0
    IADD DR14, DR0, #0
    IADD DR15, DR0, #0
    RETURNAL #0

TODO_DESTROY_INPUT_CREDENTIAL_NULL:
    HARDFAULT "Mint.DESTROY: missing Passkey"
TODO_DESTROY_INPUT_PROOF_READ:
    HARDFAULT "Mint.DESTROY: proof capability is not readable"
TODO_DESTROY_INPUT_TARGET_NULL:
    HARDFAULT "Mint.DESTROY: target is NULL"
TODO_DESTROY_INPUT_CR4_NOT_NULL:
    HARDFAULT "Mint.DESTROY: CR4 must be NULL"
TODO_DESTROY_INPUT_CR8_NOT_NULL:
    HARDFAULT "Mint.DESTROY: CR8 must be NULL"
TODO_DESTROY_RESULT_COMPLETION:
    HARDFAULT "Mint.DESTROY: operation did not complete"
TODO_DESTROY_RESULT_NOT_NULL:
    HARDFAULT "Mint.DESTROY: result capability must be NULL"
}

method MakeOutform {
MakeOutform_inputs:
    ; Proposed input: CR7 eligible live object, CR4/CR8 NULL.
    ; Result CR1: Outform for SAME object, not a replacement identity.
    BRANCH TODO_MakeOutform_CLEAR_RESULT_AUTHORITY
outform_inputs_after_clear:
    IADD DR1, DR0, #0
    TPERM CR2, NULL
    BRANCHEQ TODO_MakeOutform_INPUT_CREDENTIAL_NULL
    TPERM CR3, R
    BRANCHNE TODO_MakeOutform_INPUT_PROOF_READ
    DREAD DR2, CR3, #3
    TPERM CR7, NULL
    BRANCHEQ TODO_MakeOutform_INPUT_TARGET_NULL
    TPERM CR4, NULL
    BRANCHNE TODO_MakeOutform_INPUT_CR4_NOT_NULL
    TPERM CR8, NULL
    BRANCHNE TODO_MakeOutform_INPUT_CR8_NOT_NULL
    BRANCH TODO_MakeOutform_INPUT_TYPE_AND_AUTHORITY
outform_body:
    ; Preserve identity and backing representation before any local release.
    BRANCH TODO_MakeOutform_BODY
outform_finish:
    ; Validate identity before erasing the working evidence.
outform_result:
    MCMP DR1, #1
    BRANCHNE TODO_MakeOutform_RESULT_COMPLETION
    TPERM CR1, NULL
    BRANCHEQ TODO_MakeOutform_RESULT_NULL
    BRANCH TODO_MakeOutform_RESULT_TYPE_AND_IDENTITY
outform_return:
    IADD DR2, DR0, #0
    IADD DR3, DR0, #0
    IADD DR4, DR0, #0
    IADD DR6, DR0, #0
    IADD DR7, DR0, #0
    IADD DR8, DR0, #0
    IADD DR9, DR0, #0
    IADD DR10, DR0, #0
    IADD DR11, DR0, #0
    IADD DR12, DR0, #0
    IADD DR13, DR0, #0
    IADD DR14, DR0, #0
    IADD DR15, DR0, #0
    RETURNAL #2

TODO_MakeOutform_INPUT_CREDENTIAL_NULL:
    HARDFAULT "Mint.MakeOutform: missing Passkey"
TODO_MakeOutform_INPUT_PROOF_READ:
    HARDFAULT "Mint.MakeOutform: proof capability is not readable"
TODO_MakeOutform_INPUT_TARGET_NULL:
    HARDFAULT "Mint.MakeOutform: target is NULL"
TODO_MakeOutform_INPUT_CR4_NOT_NULL:
    HARDFAULT "Mint.MakeOutform: CR4 must be NULL"
TODO_MakeOutform_INPUT_CR8_NOT_NULL:
    HARDFAULT "Mint.MakeOutform: CR8 must be NULL"
TODO_MakeOutform_RESULT_COMPLETION:
    HARDFAULT "Mint.MakeOutform: operation did not complete"
TODO_MakeOutform_RESULT_NULL:
    HARDFAULT "Mint.MakeOutform: result capability is NULL"
}

method MakeInform {
MakeInform_inputs:
    ; Proposed input: CR7 Outform, CR4/CR8 NULL.
    ; Result CR1: Inform for SAME live object. Never resurrect a dead object.
    BRANCH TODO_MakeInform_CLEAR_RESULT_AUTHORITY
inform_inputs_after_clear:
    IADD DR1, DR0, #0
    TPERM CR2, NULL
    BRANCHEQ TODO_MakeInform_INPUT_CREDENTIAL_NULL
    TPERM CR3, R
    BRANCHNE TODO_MakeInform_INPUT_PROOF_READ
    DREAD DR2, CR3, #3
    TPERM CR7, NULL
    BRANCHEQ TODO_MakeInform_INPUT_TARGET_NULL
    TPERM CR4, NULL
    BRANCHNE TODO_MakeInform_INPUT_CR4_NOT_NULL
    TPERM CR8, NULL
    BRANCHNE TODO_MakeInform_INPUT_CR8_NOT_NULL
    BRANCH TODO_MakeInform_REQUIRE_OUTFORM_AND_AUTHORITY
inform_body:
    ; Resolve live object, bind retained destination generation, register GC.
    BRANCH TODO_MakeInform_BODY
inform_finish:
    ; Validate identity before erasing the working evidence.
inform_result:
    MCMP DR1, #1
    BRANCHNE TODO_MakeInform_RESULT_COMPLETION
    TPERM CR1, NULL
    BRANCHEQ TODO_MakeInform_RESULT_NULL
    BRANCH TODO_MakeInform_RESULT_TYPE_AND_IDENTITY
inform_return:
    IADD DR2, DR0, #0
    IADD DR3, DR0, #0
    IADD DR4, DR0, #0
    IADD DR6, DR0, #0
    IADD DR7, DR0, #0
    IADD DR8, DR0, #0
    IADD DR9, DR0, #0
    IADD DR10, DR0, #0
    IADD DR11, DR0, #0
    IADD DR12, DR0, #0
    IADD DR13, DR0, #0
    IADD DR14, DR0, #0
    IADD DR15, DR0, #0
    RETURNAL #2

TODO_MakeInform_INPUT_CREDENTIAL_NULL:
    HARDFAULT "Mint.MakeInform: missing Passkey"
TODO_MakeInform_INPUT_PROOF_READ:
    HARDFAULT "Mint.MakeInform: proof capability is not readable"
TODO_MakeInform_INPUT_TARGET_NULL:
    HARDFAULT "Mint.MakeInform: target is NULL"
TODO_MakeInform_INPUT_CR4_NOT_NULL:
    HARDFAULT "Mint.MakeInform: CR4 must be NULL"
TODO_MakeInform_INPUT_CR8_NOT_NULL:
    HARDFAULT "Mint.MakeInform: CR8 must be NULL"
TODO_MakeInform_RESULT_COMPLETION:
    HARDFAULT "Mint.MakeInform: operation did not complete"
TODO_MakeInform_RESULT_NULL:
    HARDFAULT "Mint.MakeInform: result capability is NULL"
}
}
