// Bank — dynamic Namespace-backed lockbox custody service.
//
// Bank is a dynamic CLOOMC LUMP at catalog index 54, not a hardware boot
// slot. MintKey creates private Outform storage only when it is called.
//
// Security ABI:
//   * owner_key is a BankOwnerKey capability in CR1, never an integer in DR;
//   * Deposit's source is an Inform R capability in CR2, never a scalar GT;
//   * offsets, word counts, kinds, capacities, and status values remain DR
//     values; and
//   * the live binding validates the independent 128-bit proof attached to the
//     typed owner capability, manages custody, zeroization, and recovery.
//
// The source models lifecycle state only. It cannot manufacture, inspect, or
// reconstruct authority from integer fields: the CR ABI and proof-bound runtime
// gate are the sole security boundary for those operations.

abstraction Bank {
    capabilities {
    }

    // Create(lump: CR1 Inform R) -> CR0 = BankVariable Enter capability or NULL,
    // and DR0 = 1 on success or a Bank error code on failure. CR0 is the
    // resulting Enter authority; DR0 is diagnostic data and can never authorize
    // entry. The caller must test CR0 before using the verified abstraction.
    // The LUMP is checked first: its seals, token, SELF identity, and declared
    // relationships must agree before the live binding issues this capability.
    // A hash is an integrity check, not proof of provenance by itself.
    method Create(lump: capability Inform R) {
        return(1)
    }

    // Read and Inspect operate on the typed E capability returned by Create in
    // CR0. Methods mediate every read of a Bank-owned abstraction; callers
    // cannot substitute CR3, a raw GT, DR0, or metadata for that capability.
    // Failed calls preserve the NULL/invalid CR0 state and identify the reason
    // in DR0 rather than collapsing all failures into one false value.
    // The binding returns a fresh readable Inform capability in CR4 for Read.
    // Inspect writes status=DR0, words=DR1, capacity=DR2, issue=DR3, and
    // lifecycle=DR4; private locations and tokens are never materialised.
    method Read(variable: capability BankVariable E, offset, words) {
        if (offset < 0) {
            return(0)
        }
        if (words <= 0) {
            return(0)
        }
        return(1)
    }

    method InspectVariable(variable: capability BankVariable E) {
        return(1)
    }

    // Release and RevokeVariable retire the verified variable, zeroize its
    // private storage, and clear CR0.  An owner capability (CR1) controls a
    // Bank lockbox; a BankVariable capability (CR0) controls only the verified
    // variable it names.  Nested variables are created by calling Create on a
    // readable result from Read, never by exposing the owner's private record.
    method Release(variable: capability BankVariable E) {
        return(1)
    }

    method RevokeVariable(variable: capability BankVariable E) {
        return(1)
    }

    // MintKey(capacity: DR1) -> BankOwnerKey capability in CR1, status in DR0.
    method MintKey(capacity) {
        if (capacity <= 0) {
            return(0)
        }

        var lockbox_id = read(CR7, 0)
        if (lockbox_id == 0) {
            lockbox_id = 1
        }
        write(CR7, 0, lockbox_id + 1)

        var sequence_base = read(CR7, 1)
        var sequence_incremented = sequence_base + 1
        var sequence = bfext(sequence_incremented, 0, 7)
        if (sequence == 0) {
            sequence = 1
        }
        write(CR7, 1, sequence)
        write(CR7, 2, lockbox_id)
        write(CR7, 3, sequence)
        write(CR7, 4, capacity)
        write(CR7, 5, 0)
        write(CR7, 6, 0)
        write(CR7, 7, 0)
        write(CR7, 8, 0)
        return(1)
    }

    // owner_key arrives through CR1 as BankOwnerKey; source arrives through CR2
    // as an Inform R capability. The runtime binding validates both before this
    // lifecycle policy can be entered.
    method Deposit(owner_key: capability BankOwnerKey E, source: capability Inform R, offset, words, kind) {
        var state = read(CR7, 6)
        if (state != 0) {
            return(0)
        }
        var capacity = read(CR7, 4)
        if (offset < 0) {
            return(0)
        }
        if (words <= 0) {
            return(0)
        }
        if (words > capacity) {
            return(0)
        }
        if (kind != 1) {
            if (kind != 2) {
                return(0)
            }
        }

        write(CR7, 5, words)
        write(CR7, 6, 1)
        write(CR7, 7, kind)
        write(CR7, 8, 1)
        return(1)
    }

    // owner_key: CR1 BankOwnerKey. On success the binding returns a fresh
    // Inform capability for the copied valuable in CR2 and status in DR0.
    method Withdraw(owner_key: capability BankOwnerKey E) {
        var state = read(CR7, 6)
        if (state != 1) {
            return(0)
        }

        var sequence_base = read(CR7, 1)
        var sequence_incremented = sequence_base + 1
        var next_sequence = bfext(sequence_incremented, 0, 7)
        if (next_sequence == 0) {
            next_sequence = 1
        }
        write(CR7, 1, next_sequence)
        write(CR7, 3, next_sequence)
        write(CR7, 5, 0)
        write(CR7, 6, 2)
        write(CR7, 7, 0)
        write(CR7, 8, 0)
        return(1)
    }

    // Inspect returns non-sensitive packed metadata in DR0.
    method Inspect(owner_key: capability BankOwnerKey E) {
        var state = read(CR7, 6)
        var kind = read(CR7, 7)
        var words = read(CR7, 5)
        var metadata = bfext(words, 0, 16)
        bfins(metadata, kind, 24, 6)
        bfins(metadata, state, 30, 2)
        return(metadata)
    }

    // Revoke zeroizes and retires the private record in the runtime binding.
    method Revoke(owner_key: capability BankOwnerKey E) {
        var sequence_base = read(CR7, 1)
        var sequence_incremented = sequence_base + 1
        var next_sequence = bfext(sequence_incremented, 0, 7)
        if (next_sequence == 0) {
            next_sequence = 1
        }
        write(CR7, 1, next_sequence)
        write(CR7, 3, next_sequence)
        write(CR7, 5, 0)
        write(CR7, 6, 2)
        write(CR7, 7, 0)
        write(CR7, 8, 0)
        return(1)
    }

    // Reissue an owner capability through CR1; DR0 carries status only.
    method ObtainPassKey(owner_key: capability BankOwnerKey E) {
        var state = read(CR7, 6)
        if (state == 2) {
            return(0)
        }
        var sequence_base = read(CR7, 1)
        var sequence_incremented = sequence_base + 1
        var next_sequence = bfext(sequence_incremented, 0, 7)
        if (next_sequence == 0) {
            next_sequence = 1
        }
        write(CR7, 1, next_sequence)
        write(CR7, 3, next_sequence)
        return(1)
    }

    // ExportRecovery returns protected scalar state in DR0; it still requires
    // owner_key in CR1 so a recovery envelope cannot be requested with a DR GT.
    method ExportRecovery(owner_key: capability BankOwnerKey E) {
        var state = read(CR7, 6)
        if (state != 1) {
            return(0)
        }
        write(CR7, 8, 1)
        return(1)
    }

    // protected_state is ordinary DR1 data. original_key is the typed CR1
    // owner capability for the recovery grant; the replacement key returns in
    // CR1 and success status in DR0.
    method Recover(protected_state, original_key: capability BankOwnerKey E) {
        if (protected_state == 0) {
            return(0)
        }
        var recovery_present = read(CR7, 8)
        if (recovery_present == 0) {
            return(0)
        }

        var replacement_id = read(CR7, 0)
        if (replacement_id == 0) {
            replacement_id = 1
        }
        write(CR7, 0, replacement_id + 1)
        var sequence_base = read(CR7, 1)
        var sequence_incremented = sequence_base + 1
        var next_sequence = bfext(sequence_incremented, 0, 7)
        if (next_sequence == 0) {
            next_sequence = 1
        }
        write(CR7, 1, next_sequence)
        write(CR7, 2, replacement_id)
        write(CR7, 3, next_sequence)
        write(CR7, 5, 0)
        write(CR7, 6, 0)
        write(CR7, 7, 0)
        write(CR7, 8, 0)
        return(1)
    }

    // List() -> active lockbox count in DR0.
    method List() {
        var active_id = read(CR7, 2)
        if (active_id == 0) {
            return(0)
        }
        var state = read(CR7, 6)
        if (state == 2) {
            return(0)
        }
        return(1)
    }
}