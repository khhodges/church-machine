; Native SR candidate. Only implemented methods are exported.
; Not installed, bound into a live Namespace, or a complete SR release.
; Private imports and exact layout: see security-regulator-native.md.
; DR1: home/row input, then status (0 success, 2 unencodable index).
; LOADM/SAVEM/SWITCHM clobber DR6 and CR11. Other methods use DR1..DR15.
; CALL/RETURN architectural effects still apply.
; M-control full-word writes preserve entry CR6.M/CR14.M, adding only the
; operation's required bit. The instruction consumes that added authority.
; No report delivery, host callback, ISA change or implicit recovery.
; Conversion methods remain unexported: see the native conversion conflict
; report in security-regulator-native.md. M does not permit raw Outform LOAD.
abstraction ide.SecurityRegulator {
capabilities {
    SELF E, ide.MControl W, ide.SRWork S, ide.SRWork RW,
    ide.Namespace RW, ide.SRConfig R
}

method LOADM() {
    ; CR1 source; exact loaded GT replaces CR1, including NULL.
    BFEXT DR6, DR1, #10, #22
    MCMP DR6, #0
    BRANCHNE bad_load_index
    LOAD CR11, CR6, #1
    ; 0x4042 = M(CR14, CR6, CR1).
    IADD DR6, DR0, #257
    SHL DR6, DR6, #6
    IADD DR6, DR6, #2
    DWRITE DR6, CR11, #0
    LOAD CR1, CR1, DR1
    LOAD CR11, NULL
    IADD DR1, DR0, #0
    RETURNAL #2
bad_load_index:
    IADD DR1, DR0, #2
    RETURNAL #2
}

method SAVEM() {
    ; CR1 destination, CR2 value. SAVE clears B in the stored copy only.
    BFEXT DR6, DR1, #10, #22
    MCMP DR6, #0
    BRANCHNE bad_save_index
    LOAD CR11, CR6, #1
    IADD DR6, DR0, #257
    SHL DR6, DR6, #6
    IADD DR6, DR6, #2
    DWRITE DR6, CR11, #0
    SAVE CR2, CR1, DR1
    LOAD CR11, NULL
    IADD DR1, DR0, #0
    RETURNAL #6
bad_save_index:
    IADD DR1, DR0, #2
    RETURNAL #6
}

method SWITCHM() {
    ; CR1 must have explicit L. Execution is on SYSTEM Thread slot 2.
    BFEXT DR6, DR1, #10, #22
    MCMP DR6, #0
    BRANCHNE bad_switch_index
    LOAD CR11, CR6, #1
    ; 0xC040 = M(CR15, CR14, CR6); no source M bypass.
    IADD DR6, DR0, #769
    SHL DR6, DR6, #6
    DWRITE DR6, CR11, #0
    LOAD CR11, NULL
    SWITCH CR1, DR1
    ; Reached only after another SWITCH restores this matching context.
    IADD DR1, DR0, #0
    RETURN
bad_switch_index:
    IADD DR1, DR0, #2
    RETURN
}

; The current construction path supports Inform GTs. Other Ctype values
; reject explicitly; it never invents Outform or Abstract identity fields.
; Permissions is the native four-bit (perm3 << 1) | domain encoding.
method MintM() {
    MCMP DR1, #1
    BRANCHNE mint_type
    BFEXT DR6, DR2, #4, #28
    MCMP DR6, #0
    BRANCHNE mint_permissions
    BFEXT DR6, DR2, #0, #1
    MCMP DR6, #0
    BRANCHEQ mint_fields
    MCMP DR2, #9
    BRANCHHI mint_permissions
mint_fields:
    BFEXT DR6, DR3, #16, #16
    MCMP DR6, #0
    BRANCHNE mint_slot
    IADD DR4, DR0, #1
    SHL DR4, DR4, #25
    SHL DR6, DR2, #27
    IADD DR4, DR4, DR6
    IADD DR4, DR4, DR3
    IADD DR9, DR0, #1
    IADD DR10, DR0, #3
    _Descriptor()
mint_type:
    IADD DR1, DR0, #4
    RETURN
mint_permissions:
    IADD DR1, DR0, #5
    RETURN
mint_slot:
    IADD DR1, DR0, #6
    RETURN
}

method SetB() {
    IADD DR10, DR0, #1
    _Select()
}

method IncrementVersion() {
    IADD DR10, DR0, #2
    _Select()
}

method SetNear() {
    IADD DR10, DR0, #5
    _Select()
}

method SetFar() {
    IADD DR10, DR0, #6
    _Select()
}

; Private helpers lower to intra-LUMP branches, not CALL. Private selectors
; contain zero dispatch entries and cannot be invoked through a public CALL.
; DR9 keeps selected CR; DR10 keeps operation. CR11 is the only CR scratch.
private method _Select() {
    IADD DR9, DR1, #0
    MCMP DR9, #10
    BRANCHHI bad_register
    MCMP DR9, #5
    BRANCHEQ bad_register
    MCMP DR9, #6
    BRANCHEQ bad_register
    LOAD CR11, CR6, #2
    MCMP DR9, #0
    BRANCHEQ selected_0
    MCMP DR9, #1
    BRANCHEQ selected_1
    MCMP DR9, #2
    BRANCHEQ selected_2
    MCMP DR9, #3
    BRANCHEQ selected_3
    MCMP DR9, #4
    BRANCHEQ selected_4
    MCMP DR9, #7
    BRANCHEQ selected_7
    MCMP DR9, #8
    BRANCHEQ selected_8
    MCMP DR9, #9
    BRANCHEQ selected_9
    SAVE CR10, CR11, #1
    BRANCH selected_read
selected_0:
    SAVE CR0, CR11, #1
    BRANCH selected_read
selected_1:
    SAVE CR1, CR11, #1
    BRANCH selected_read
selected_2:
    SAVE CR2, CR11, #1
    BRANCH selected_read
selected_3:
    SAVE CR3, CR11, #1
    BRANCH selected_read
selected_4:
    SAVE CR4, CR11, #1
    BRANCH selected_read
selected_7:
    SAVE CR7, CR11, #1
    BRANCH selected_read
selected_8:
    SAVE CR8, CR11, #1
    BRANCH selected_read
selected_9:
    SAVE CR9, CR11, #1
selected_read:
    LOAD CR11, CR6, #3
    DREAD DR4, CR11, #62
    DWRITE DR0, CR11, #62
    BFEXT DR6, DR4, #25, #2
    MCMP DR6, #0
    BRANCHEQ null_input
    MCMP DR6, #1
    BRANCHNE unsupported_type
    _Descriptor()
null_input:
    IADD DR1, DR0, #3
    _Reject()
unsupported_type:
    IADD DR1, DR0, #4
    _Reject()
bad_register:
    ; No selected register exists to clear for an invalid selector.
    IADD DR1, DR0, #2
    RETURNAL #1951
}

private method _Descriptor() {
    BFEXT DR6, DR4, #0, #16
    LOAD CR11, CR6, #5
    DREAD DR8, CR11, #0
    BFEXT DR2, DR8, #0, #2
    MCMP DR2, #0
    BRANCHNE invalid_config
    MCMP DR8, #4
    BRANCHLO invalid_config
    SHR DR2, DR8, #2
    MCMP DR6, DR2
    BRANCHHS bad_slot
    SHL DR6, DR6, #2
    ISUB DR8, DR8, #4
    ISUB DR8, DR8, DR6
    LOAD CR11, CR6, #4
    DREAD DR5, CR11, #0, DR8
    DREAD DR7, CR11, #1, DR8
    ; All-zero entries have no live object identity.
    MCMP DR5, #0
    BRANCHNE present
    MCMP DR7, #0
    BRANCHEQ bad_slot
present:
    _Integrity()
bad_slot:
    IADD DR1, DR0, #6
    _Reject()
invalid_config:
    HARDFAULT "SR: invalid private Namespace span configuration"
}

private method _Integrity() {
    ; Existing integrity32: rol(W0,7) XOR rol(W1 & 0x3fffffff,13)
    ; XOR 0xDEADBEEF. This is the same native bit loop used by Mint.
    BFEXT DR12, DR5, #25, #7
    SHL DR13, DR5, #7
    BFINS DR13, DR12, #0, #7
    IADD DR14, DR7, #0
    BFINS DR14, DR0, #30, #2
    BFEXT DR12, DR14, #19, #13
    SHL DR14, DR14, #13
    BFINS DR14, DR12, #0, #13
    IADD DR15, DR0, #222
    SHL DR15, DR15, #8
    IADD DR15, DR15, #173
    SHL DR15, DR15, #8
    IADD DR15, DR15, #190
    SHL DR15, DR15, #8
    IADD DR15, DR15, #239
    IADD DR6, DR0, #0
    IADD DR11, DR0, #32
integrity_loop:
    BFEXT DR1, DR13, #0, #1
    BFEXT DR2, DR14, #0, #1
    BFEXT DR3, DR15, #0, #1
    IADD DR1, DR1, DR2
    IADD DR1, DR1, DR3
    SHR DR6, DR6, #1
    BFINS DR6, DR1, #31, #1
    SHR DR13, DR13, #1
    SHR DR14, DR14, #1
    SHR DR15, DR15, #1
    ISUB DR11, DR11, #1
    MCMP DR11, DR0
    BRANCHNE integrity_loop
    MCMP DR10, #4
    BRANCHEQ commit_version
    DREAD DR2, CR11, #2, DR8
    MCMP DR6, DR2
    BRANCHNE corrupt_descriptor
    BFEXT DR3, DR7, #21, #9
    MCMP DR10, #3
    BRANCHEQ mint_result
    BFEXT DR2, DR4, #16, #9
    MCMP DR2, DR3
    BRANCHNE stale_gt
    MCMP DR10, #1
    BRANCHEQ set_b
    MCMP DR10, #5
    BRANCHEQ set_near
    MCMP DR10, #6
    BRANCHEQ set_far
    MCMP DR3, #511
    BRANCHEQ exhausted
    IADD DR3, DR3, #1
    BFINS DR7, DR3, #21, #9
    IADD DR10, DR0, #4
    _Integrity()
commit_version:
    ; No CALL, CHANGE or host callback between the paired descriptor writes.
    ; Failure is architectural HardFault, not a claimed software rollback.
    DWRITE DR7, CR11, #1, DR8
    DWRITE DR6, CR11, #2, DR8
    IADD DR1, DR0, #0
    _ClearSelected()
mint_result:
    BFINS DR4, DR3, #16, #9
    _Materialize()
set_b:
    IADD DR2, DR0, #1
    BFINS DR4, DR2, #31, #1
    _Materialize()
set_near:
    IADD DR2, DR0, #0
    BRANCH write_f
set_far:
    IADD DR2, DR0, #1
write_f:
    ; F is the Namespace authority's bit 31, not a bit in the 32-bit GT.
    ; Its integrity encoding excludes F. Refresh the selected descriptor.
    BFINS DR7, DR2, #31, #1
    DWRITE DR7, CR11, #1, DR8
    _Materialize()
exhausted:
    IADD DR1, DR0, #1
    _ClearSelected()
stale_gt:
    IADD DR1, DR0, #7
    _Reject()
corrupt_descriptor:
    HARDFAULT "SR: Namespace descriptor integrity mismatch"
}

private method _Reject() {
    MCMP DR10, #2
    BRANCHNE keep_input
    _ClearSelected()
keep_input:
    LOAD CR11, NULL
    RETURNAL #1951
}

private method _Materialize() {
    LOAD CR11, CR6, #2
    SAVE CR10, CR11, #2
    LOAD CR11, CR6, #3
    DWRITE DR4, CR11, #62
    LOAD CR10, CR6, #1
    LOAD CR11, CR6, #3
    ; Preserve CR6/CR14 M, and authorize scratch CR11 once: 0x4840.
    IADD DR6, DR0, #289
    SHL DR6, DR6, #6
    DWRITE DR6, CR10, #0
    MCMP DR9, #0
    BRANCHEQ result_0
    MCMP DR9, #1
    BRANCHEQ result_1
    MCMP DR9, #2
    BRANCHEQ result_2
    MCMP DR9, #3
    BRANCHEQ result_3
    MCMP DR9, #4
    BRANCHEQ result_4
    MCMP DR9, #7
    BRANCHEQ result_7
    MCMP DR9, #8
    BRANCHEQ result_8
    MCMP DR9, #9
    BRANCHEQ result_9
    LOAD CR10, CR11, #1
    BRANCH materialized
result_0:
    LOAD CR0, CR11, #1
    BRANCH materialized
result_1:
    LOAD CR1, CR11, #1
    BRANCH materialized
result_2:
    LOAD CR2, CR11, #1
    BRANCH materialized
result_3:
    LOAD CR3, CR11, #1
    BRANCH materialized
result_4:
    LOAD CR4, CR11, #1
    BRANCH materialized
result_7:
    LOAD CR7, CR11, #1
    BRANCH materialized
result_8:
    LOAD CR8, CR11, #1
    BRANCH materialized
result_9:
    LOAD CR9, CR11, #1
materialized:
    MCMP DR9, #10
    BRANCHEQ materialize_cleanup
    DWRITE DR6, CR10, #0
    LOAD CR10, CR11, #2
materialize_cleanup:
    DWRITE DR0, CR11, #62
    DWRITE DR0, CR11, #63
    LOAD CR11, NULL
    IADD DR1, DR0, #0
    RETURNAL #1951
}

private method _ClearSelected() {
    MCMP DR9, #0
    BRANCHEQ clear_0
    MCMP DR9, #1
    BRANCHEQ clear_1
    MCMP DR9, #2
    BRANCHEQ clear_2
    MCMP DR9, #3
    BRANCHEQ clear_3
    MCMP DR9, #4
    BRANCHEQ clear_4
    MCMP DR9, #7
    BRANCHEQ clear_7
    MCMP DR9, #8
    BRANCHEQ clear_8
    MCMP DR9, #9
    BRANCHEQ clear_9
    LOAD CR10, NULL
    BRANCH cleared
clear_0:
    LOAD CR0, NULL
    BRANCH cleared
clear_1:
    LOAD CR1, NULL
    BRANCH cleared
clear_2:
    LOAD CR2, NULL
    BRANCH cleared
clear_3:
    LOAD CR3, NULL
    BRANCH cleared
clear_4:
    LOAD CR4, NULL
    BRANCH cleared
clear_7:
    LOAD CR7, NULL
    BRANCH cleared
clear_8:
    LOAD CR8, NULL
    BRANCH cleared
clear_9:
    LOAD CR9, NULL
cleared:
    LOAD CR11, NULL
    RETURNAL #1951
}
}
