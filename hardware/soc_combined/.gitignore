# Efinity build scratch and reports — everything in these two directories is
# regenerated by run_efx_map.sh / run_efx_pnr.sh / run_efx_pgm.sh. Only the
# verified reference artifacts below are meant to be tracked (via Git LFS).
outflow/*
!outflow/README.md
!outflow/church_soc_cm.hex
!outflow/church_soc_cm.bit

work_syn/*
!work_syn/church_dmem.mem

# P&R scratch workspace — nothing here is ever meant to be committed.
work_pnr/

# Efinity top-level build logs
EFX.*.log
build*.log
pgm*.log
pnr*.log
syn*.log

# BRAM symbol / DMEM patch scratch files (regenerated by patch_*.py each build)
EfxSapphireSoc.v_toplevel_system_ramA_logic_ram_symbol*.bin
cm_dmem_b[0-9].bin
cm_dmem_bram.*
debug_profile.mark_debug.json
*.pre_direct
sapphire.v.bak*
top.map.rdb
top.map.rpt
top.raminfo.pb
top.res.csv
top.vdb

# Built firmware binaries — source (firmware/*.c, *.h, Makefile) stays tracked
firmware/firmware.bin
firmware/firmware.elf
firmware/firmware.hex
