; Qualified loader for the new candidate. Not the final round-robin scheduler.
; Handoff is private SYSTEM data: Namespace96, Thread GT, exact target GT.
; Targets is a private L table, indexed by DR1, of bounded destination RW GTs.
abstraction candidate.Amoeba {
    capabilities {
        SELF E, candidate.Targets L, candidate.Receiver RW,
        candidate.Handoff R, candidate.UserThread, candidate.SystemThread
    }
    main method Run() {
        LOAD CR2, CR6, #0
        CALL CR2, #1
        CALL CR1, #0
    Completed:
        CHANGE CR12
        BRANCH Completed
    }
    method EnsureResident() {
        LOAD CR2, CR6, #1
        LOAD CR3, CR2, DR1
        DREAD DR9, CR3, #0
        SHL DR7, DR9, #9
        SHR DR7, DR7, #19
        ISUB DR8, DR7, #0
        BRANCHNE Resident
        LOAD CR4, CR6, #2
        LOAD CR8, CR6, #3
        DREAD DR7, CR8, #0
        DWRITE DR7, CR4, #7
        DREAD DR7, CR8, #1
        DWRITE DR7, CR4, #8
        DREAD DR7, CR8, #2
        DWRITE DR7, CR4, #9
        DREAD DR7, CR8, #3
        DWRITE DR7, CR4, #10
        DREAD DR7, CR8, #4
        DWRITE DR7, CR4, #11
        IADD DR7, DR0, #1
        DWRITE DR7, CR4, #5
    Waiting:
        DREAD DR7, CR4, #1
        ISUB DR8, DR7, #4
        BRANCHEQ Ready
        ISUB DR8, DR7, #7
        BRANCHEQ Invalid
        CHANGE CR12
        BRANCH Waiting
    Ready:
        DREAD DR7, CR4, #2
        DREAD DR8, CR8, #4
        ISUB DR8, DR7, DR8
        BRANCHNE Invalid
        DREAD DR11, CR4, #4
        DREAD DR10, CR4, #6
        SHL DR7, DR10, #9
        SHR DR7, DR7, #19
        SHL DR7, DR7, #10
        ISUB DR8, DR10, DR7
        ISUB DR8, DR8, DR9
        BRANCHNE Invalid
        DREAD DR9, CR4, #0
        ISUB DR8, DR9, DR10
        BRANCHNE Invalid
        IADD DR6, DR0, #1
    Copy:
        DREAD DR7, CR4, #0
        DWRITE DR7, CR3, DR6
        IADD DR6, DR6, #1
        ISUB DR8, DR6, DR11
        BRANCHNE Copy
        DWRITE DR9, CR3, #0
        DREAD DR7, CR4, #3
        DWRITE DR7, CR4, #3
    Resident:
        IADD DR1, DR0, #0
        RETURNAL 2
    Invalid:
        HARDFAULT "Qualified Amoeba delivery failed"
    }
}
