; Isolated SWITCH mechanism qualification, NOT a complete SecurityRegulator.
; Reporting is optional external observation, never an execution dependency.
; Final invocation/audit identity and physical transport remain unqualified.
; Row 2: the one locally bound next-Namespace GT; no volatile argument storage.
; The configured M-control device grant is private to this executable.
abstraction candidate.SecurityRegulator {
    capabilities {
        SELF E, candidate.MBits W, candidate.NextNamespace
    }
    method SwitchM() {
        LOAD CR9, CR6, #1
        IADD DR7, DR0, #1
        SHL DR7, DR7, #15
        IADD DR7, DR7, #64
        DWRITE DR7, CR9, #0
        SWITCH CR6, #2
        RETURN
    }
}
