+                              (3, 0x2000, 63), (4, 0x3000, 255),
+                              (5, 0x4000, 63), (6, 0x5000, 63)]:
+        authority = limit | ((version << 21) if slot == 4 else 0)
+        for i, value in enumerate((base, authority, integrity32(base, authority), 0)):
+            mem[slot * 16 + i * 4] = value
