+"""Isolated candidate top/ROM/BRAM/UART test; never contacts hardware."""
+import binascii
+import pytest
+from amaranth.sim import Simulator
+from hardware.wukong_top import ChurchWukongXC7A100T
+from hardware.test_phase2_guarded_llr import guarded_fixture, GUARD, SYSTEM_GT, USER_GT
+
+
+@pytest.mark.parametrize("baud", [125000, 62500])
+def test_top_stops_before_system_instruction_and_drains_snapshot(baud):
+    words = [0] * 16384
+    for addr, word in guarded_fixture().items():
+        words[addr // 4] = word
+    top = ChurchWukongXC7A100T(sim_mode=True, clk_freq=1000000, baud=baud,
+                    sim_boot_image_words=words, expected_boot_guard=GUARD,
+                    diagnostic_llr_stop=True)
+    async def bench(ctx):
+        ctx.set(top.uart_rx_pin, 1)
+        stopped = False
+        frame = bytearray()
+        stalled = 0
+        for cycle in range(150000):
+            core = top.sim_core
+            assert not ctx.get(core.fault_valid), (cycle, ctx.get(core.fault), hex(ctx.get(core.imem_addr)))
+            if ctx.get(core.retire_valid):
+                assert ctx.get(core.retire_nia) not in (0x4008, 0x2010)
+            if ctx.get(core.llr_complete) or ctx.get(top.diagnostic_llr_stopped):
+                stopped = True
+                assert not ctx.get(core.imem_valid), "SYSTEM fetch escaped stop"
+                assert ctx.get(core.imem_addr) == 0x2010
+                assert ctx.get(core.debug_cr_words[12][0]) == SYSTEM_GT
+                assert [ctx.get(x) for x in core.debug_dr_words[:7]] == [
+                    0, words[0], words[1], words[2], words[3], 6, USER_GT]
+                assert ctx.get(core.flags.as_value()) == 2
+                assert not ctx.get(core.dmem_wr_en)
+            if ctx.get(top.sim_snapshot_req):
+                if ctx.get(top.sim_snapshot_ack):
+                    frame.append(ctx.get(top.sim_snapshot_byte))
+                else:
+                    stalled += 1
+            if ctx.get(top.sim_snapshot_complete):
+                assert stopped and stalled > 0
+                assert ctx.get(top.sim_snapshot_reason) == 3
+                assert len(frame) == int.from_bytes(frame[2:4], "big") + 8
+                assert binascii.crc_hqx(frame[:-2], 0xffff) == int.from_bytes(frame[-2:], "big")
+                for _ in range(100):
+                    await ctx.tick()
+                    assert not ctx.get(core.imem_valid)
+                    assert ctx.get(core.imem_addr) == 0x2010
+                return
+            await ctx.tick()
+        pytest.fail(f"observer limit; stopped={stopped}, snapshot_bytes={len(frame)}")
+    sim = Simulator(top)
+    sim.add_clock(1e-6)
+    sim.add_testbench(bench)
+    sim.run()
