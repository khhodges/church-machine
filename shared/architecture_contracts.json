{
  "schemaVersion": 1,
  "name": "Church Machine architecture contracts",
  "canonical": true,
  "isa": {
    "gtWord0": {
      "widthBits": 32,
      "fields": {
        "slot_id": [0, 15],
        "gt_seq": [16, 24],
        "gt_type": [25, 26],
        "dom": [27, 27],
        "perm": [28, 30],
        "b_flag": [31, 31]
